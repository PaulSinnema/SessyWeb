@page "/consumption"
@inherits PageBase
@using System
@using SessyController.Services
@using SessyController.Services.Items
@using SessyWeb.Components
@using static SessyWeb.Components.DateChooserComponent

@code {
    bool ShowDataLabels = true;
    bool ShowMarkers = false;
}

<PageTitle>Consumption</PageTitle>

<RadzenLayout Style="height: 80vh;">
    <RadzenHeader Style="height: 100%;margin: 0px; padding: 0px;">
        <RadzenStack Orientation=Orientation.Horizontal AlignItems="AlignItems.Center" Style="height:100%;margin: 0px; padding: 0px;">
            @* TickDistance: <p>@TickDistance</p> *@

            <DateChooserComponent SelectionChanged="@((DateArgs d) => DateSelectionChanged(d))" CustomChooserEnabled="true" />

            <RadzenLabel Text="@T("Show labels")" Component="ShowDataLabels" />
            <RadzenCheckBox @bind-Value="@ShowDataLabels" Name="ShowDataLabels" />

            @if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Day)
            {
                <RadzenLabel Text="@T("Show markers")" Component="ShowMarkers" />
                <RadzenCheckBox @bind-Value="@ShowMarkers" Name="ShowMarkers" />
            }

            <RadzenLabel Text="@T("Show weather")" Component="ShowWeather" />
            <RadzenCheckBox @bind-Value="@ShowWeather" Name="ShowWeather" />

            @if (DateSelectionChosen!.PeriodChosen != PeriodsEnums.All)
            {
                <RadzenLabel Text="@T("Compare:")" Component="CompareMode" />
                <RadzenDropDown TValue="CompareModes"
                                @bind-Value="@CompareMode"
                                Data="@CompareOptions"
                                ValueProperty="Mode"
                                TextProperty="Text"
                                Change="@(_ => CompareChanged())"
                                Style="width: 150px;"
                                Name="CompareMode" />
            }

        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <RadzenTabs @bind-SelectedIndex="@SelectedTab">
            <Tabs>
                <RadzenTabsItem Text="@T("Consumption")">
                @if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Day)
                {
                    <RadzenCard Style="@CardStyle">
                        <RadzenLabel Text="@T("Consumption")" Component="RadzenDropDownBindValue" class="h4 m-2" />

                        <RadzenChart Style="@GraphStyle" @ref=ConsumptionDayChart>
                            <RadzenChartTooltipOptions Shared="true" />
                            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                            <RadzenAreaSeries Data="@ConsumptionDayData"
                                              Stroke="var(--sessy-consumption-line)"
                                              StrokeWidth="2"
                                              Fill="var(--sessy-consumption-area)"
                                              Title="@T("Consumption")"
                                              CategoryProperty="Time"
                                              ValueProperty="ConsumptionKWh"
                                              Smooth="true"
                                              LineType="LineType.Solid">
                                <ChildContent>
                                    <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                                    <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                                </ChildContent>
                            </RadzenAreaSeries>

                            @foreach (var offset in ShownOffsets)
                            {
                                <RadzenLineSeries Data="@DayCompare[offset]"
                                                  Stroke="@OffsetColor(offset, "line")"
                                                  StrokeWidth="2"
                                                  Title="@ConsumptionTitle(offset)"
                                                  CategoryProperty="Time"
                                                  ValueProperty="ConsumptionKWh"
                                                  Smooth="true"
                                                  LineType="LineType.Solid">
                                    <ChildContent>
                                        <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                                    </ChildContent>
                                </RadzenLineSeries>
                            }

                            @if (ShowWeather)
                            {
                                <RadzenLineSeries Data="@ConsumptionDayData"
                                                  Stroke="var(--sessy-temperature-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Temperature")"
                                                  CategoryProperty="Time"
                                                  ValueProperty="Temperature"
                                                  ValueAxisName="temperature"
                                                  Smooth="true"
                                                  LineType="LineType.Solid">
                                    <ChildContent>
                                        <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                                    </ChildContent>
                                </RadzenLineSeries>

                                foreach (var offset in ShownOffsets)
                                {
                                    <RadzenLineSeries Data="@DayCompare[offset]"
                                                      Stroke="@TemperatureColor(offset)"
                                                      StrokeWidth="2"
                                                      Title="@T("Temperature {0}", CompareTitles[offset])"
                                                      CategoryProperty="Time"
                                                      ValueProperty="Temperature"
                                                      ValueAxisName="temperature"
                                                      Smooth="true"
                                                      LineType="LineType.Solid">
                                    </RadzenLineSeries>
                                }

                                <RadzenLineSeries Data="@ConsumptionDayData"
                                                  Stroke="var(--sessy-radiation-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Global radiation")"
                                                  CategoryProperty="Time"
                                                  ValueProperty="GlobalRadiation"
                                                  Hidden="true"
                                                  ValueAxisName="radiation"
                                                  Smooth="true"
                                                  LineType="LineType.Solid">
                                    <ChildContent>
                                        <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                                    </ChildContent>
                                </RadzenLineSeries>

                                <RadzenLineSeries Data="@ConsumptionDayData"
                                                  Stroke="var(--sessy-humidity-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Humidity")"
                                                  CategoryProperty="Time"
                                                  ValueProperty="Humidity"
                                                  Hidden="true"
                                                  ValueAxisName="humidity"
                                                  Smooth="true"
                                                  LineType="LineType.Solid">
                                    <ChildContent>
                                        <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                                    </ChildContent>
                                </RadzenLineSeries>
                            }

                            <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Time")" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Wh")" />
                            </RadzenValueAxis>
                            @if (ShowWeather)
                            {
                                <RadzenValueAxis Name="temperature" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Celsius")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="radiation" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Watt / m2")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="humidity" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Percentage")" />
                                </RadzenValueAxis>
                            }
                        </RadzenChart>
                    </RadzenCard>
                }
                else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Week)
                {
                    <RadzenCard Style="@CardStyle">
                        <RadzenChart Style="@GraphStyle" @ref=ConsumptionWeekChart>
                            <RadzenChartTooltipOptions Shared="true" />
                            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                            @foreach (var offset in ShownOffsets)
                            {
                                <RadzenColumnSeries Data="@WeekPerYear[offset]"
                                                    Stroke="@OffsetColor(offset, "line")"
                                                    StrokeWidth="2"
                                                    Fill="@OffsetColor(offset, "area")"
                                                    Title="@ConsumptionTitle(offset)"
                                                    CategoryProperty="DayOfWeek"
                                                    ValueProperty="ConsumptionKWh">
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                            }

                            @if (ShowWeather)
                            {
                                foreach (var offset in ShownOffsets)
                                {
                                    <RadzenLineSeries Data="@WeekWithData[offset]"
                                                      Stroke="@TemperatureColor(offset)"
                                                      StrokeWidth="2"
                                                      Title="@TemperatureTitle(offset)"
                                                      CategoryProperty="DayOfWeek"
                                                      ValueProperty="Temperature"
                                                      ValueAxisName="temperature"
                                                      LineType="LineType.Solid">
                                    </RadzenLineSeries>
                                }

                                <RadzenLineSeries Data="@ConsumptionWeekData"
                                                  Stroke="var(--sessy-radiation-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. global radiation")"
                                                  CategoryProperty="DayOfWeek"
                                                  ValueProperty="GlobalRadiation"
                                                  Hidden="true"
                                                  ValueAxisName="radiation"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>

                                <RadzenLineSeries Data="@ConsumptionWeekData"
                                                  Stroke="var(--sessy-humidity-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. humidity")"
                                                  CategoryProperty="DayOfWeek"
                                                  ValueProperty="Humidity"
                                                  Hidden="true"
                                                  ValueAxisName="humidity"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>
                            }

                            <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45" Padding="20">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Day")" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Wh")" />
                            </RadzenValueAxis>
                            @if (ShowWeather)
                            {
                                <RadzenValueAxis Name="temperature" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Celsius")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="radiation" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Watt / m2")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="humidity" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Percentage")" />
                                </RadzenValueAxis>
                            }
                        </RadzenChart>
                    </RadzenCard>
                }
                else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Month)
                {
                    <RadzenCard Style="@CardStyle">
                        <RadzenChart Style="@GraphStyle" @ref=ConsumptionMonthChart>
                            <RadzenChartTooltipOptions Shared="true" />
                            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                            @foreach (var offset in ShownOffsets)
                            {
                                <RadzenColumnSeries Data="@MonthPerYear[offset]"
                                                    Stroke="@OffsetColor(offset, "line")"
                                                    StrokeWidth="2"
                                                    Fill="@OffsetColor(offset, "area")"
                                                    Title="@ConsumptionTitle(offset)"
                                                    CategoryProperty="DayOfWeek"
                                                    ValueProperty="ConsumptionKWh">
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                            }

                            @if (ShowWeather)
                            {
                                foreach (var offset in ShownOffsets)
                                {
                                    <RadzenLineSeries Data="@MonthWithData[offset]"
                                                      Stroke="@TemperatureColor(offset)"
                                                      StrokeWidth="2"
                                                      Title="@TemperatureTitle(offset)"
                                                      CategoryProperty="DayOfWeek"
                                                      ValueProperty="Temperature"
                                                      ValueAxisName="temperature"
                                                      LineType="LineType.Solid">
                                    </RadzenLineSeries>
                                }

                                <RadzenLineSeries Data="@ConsumptionMonthData"
                                                  Stroke="var(--sessy-radiation-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. global radiation")"
                                                  CategoryProperty="DayOfWeek"
                                                  ValueProperty="GlobalRadiation"
                                                  Hidden="true"
                                                  ValueAxisName="radiation"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>

                                <RadzenLineSeries Data="@ConsumptionMonthData"
                                                  Stroke="var(--sessy-humidity-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. humidity")"
                                                  CategoryProperty="DayOfWeek"
                                                  ValueProperty="Humidity"
                                                  Hidden="true"
                                                  ValueAxisName="humidity"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>
                            }

                            <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Day")" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Wh")" />
                            </RadzenValueAxis>
                            @if (ShowWeather)
                            {
                                <RadzenValueAxis Name="temperature" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Celsius")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="radiation" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Watt / m2")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="humidity" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Percentage")" />
                                </RadzenValueAxis>
                            }
                        </RadzenChart>
                    </RadzenCard>

                }
                else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Year)
                {
                    <RadzenCard Style="@CardStyle">
                        <RadzenChart Style="@GraphStyle" @ref=ConsumptionYearChart>
                            <RadzenChartTooltipOptions Shared="true" />
                            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                            @foreach (var offset in ShownOffsets)
                            {
                                <RadzenColumnSeries Data="@YearPerYear[offset]"
                                                    Stroke="@OffsetColor(offset, "line")"
                                                    StrokeWidth="2"
                                                    Fill="@OffsetColor(offset, "area")"
                                                    Title="@ConsumptionTitle(offset)"
                                                    CategoryProperty="MonthOfYear"
                                                    ValueProperty="ConsumptionKWh">
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                            }

                            @if (ShowWeather)
                            {
                                foreach (var offset in ShownOffsets)
                                {
                                    <RadzenLineSeries Data="@YearWithData[offset]"
                                                      Stroke="@TemperatureColor(offset)"
                                                      StrokeWidth="2"
                                                      Title="@TemperatureTitle(offset)"
                                                      CategoryProperty="MonthOfYear"
                                                      ValueProperty="Temperature"
                                                      ValueAxisName="temperature"
                                                      LineType="LineType.Solid">
                                    </RadzenLineSeries>
                                }

                                <RadzenLineSeries Data="@ConsumptionYearData"
                                                  Stroke="var(--sessy-radiation-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. global radiation")"
                                                  CategoryProperty="MonthOfYear"
                                                  ValueProperty="GlobalRadiation"
                                                  Hidden="true"
                                                  ValueAxisName="radiation"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>

                                <RadzenLineSeries Data="@ConsumptionYearData"
                                                  Stroke="var(--sessy-humidity-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. humidity")"
                                                  CategoryProperty="MonthOfYear"
                                                  ValueProperty="Humidity"
                                                  Hidden="true"
                                                  ValueAxisName="humidity"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>
                            }

                            <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Month")" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Wh")" />
                            </RadzenValueAxis>
                            @if (ShowWeather)
                            {
                                <RadzenValueAxis Name="temperature" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Celsius")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="radiation" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Watt / m2")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="humidity" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Percentage")" />
                                </RadzenValueAxis>
                            }
                        </RadzenChart>
                    </RadzenCard>

                }
                else if(DateSelectionChosen!.PeriodChosen == PeriodsEnums.All)
                {
                    <RadzenCard Style="@CardStyle">
                        <RadzenChart Style="@GraphStyle" @ref=ConsumptionAllChart>
                            <RadzenChartTooltipOptions Shared="true" />
                            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                            @foreach (var year in AllYears)
                            {
                                <RadzenColumnSeries Data="@ConsumptionAllPerYear[year]"
                                                    Stroke="@YearColor(year, "line")"
                                                    StrokeWidth="2"
                                                    Fill="@YearColor(year, "area")"
                                                    Title="@T("Consumption {0}", year)"
                                                    CategoryProperty="MonthOfYear"
                                                    ValueProperty="ConsumptionKWh">
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                            }

                            @if (ShowWeather)
                            {
                                foreach (var year in AllYears)
                                {
                                    <RadzenLineSeries Data="@AllWithData[year]"
                                                      Stroke="@TemperatureColor(AllYears.Last() - year)"
                                                      StrokeWidth="2"
                                                      Title="@T("Avg. temperature {0}", year)"
                                                      CategoryProperty="MonthOfYear"
                                                      ValueProperty="Temperature"
                                                      ValueAxisName="temperature"
                                                      LineType="LineType.Solid">
                                    </RadzenLineSeries>
                                }

                                <RadzenLineSeries Data="@ConsumptionAllWeather"
                                                  Stroke="var(--sessy-radiation-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. global radiation")"
                                                  CategoryProperty="MonthOfYear"
                                                  ValueProperty="GlobalRadiation"
                                                  Hidden="true"
                                                  ValueAxisName="radiation"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>

                                <RadzenLineSeries Data="@ConsumptionAllWeather"
                                                  Stroke="var(--sessy-humidity-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. humidity")"
                                                  CategoryProperty="MonthOfYear"
                                                  ValueProperty="Humidity"
                                                  Hidden="true"
                                                  ValueAxisName="humidity"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>
                            }

                            <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Month")" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Wh")" />
                            </RadzenValueAxis>
                            @if (ShowWeather)
                            {
                                <RadzenValueAxis Name="temperature" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Celsius")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="radiation" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Watt / m2")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="humidity" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Percentage")" />
                                </RadzenValueAxis>
                            }
                        </RadzenChart>
                    </RadzenCard>
                }
                else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Custom)
                {
                    <RadzenCard Style="@CardStyle">
                        <RadzenChart Style="@GraphStyle" @ref=ConsumptionCustomChart>
                            <RadzenChartTooltipOptions Shared="true" />
                            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                            @foreach (var offset in ShownOffsets)
                            {
                                <RadzenColumnSeries Data="@CustomPerYear[offset]"
                                                    Stroke="@OffsetColor(offset, "line")"
                                                    StrokeWidth="2"
                                                    Fill="@OffsetColor(offset, "area")"
                                                    Title="@ConsumptionTitle(offset)"
                                                    CategoryProperty="X"
                                                    ValueProperty="ConsumptionKWh">
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                            }

                            @if (ShowWeather)
                            {
                                foreach (var offset in ShownOffsets)
                                {
                                    <RadzenLineSeries Data="@CustomWithData[offset]"
                                                      Stroke="@TemperatureColor(offset)"
                                                      StrokeWidth="2"
                                                      Title="@TemperatureTitle(offset)"
                                                      CategoryProperty="X"
                                                      ValueProperty="Temperature"
                                                      ValueAxisName="temperature"
                                                      LineType="LineType.Solid">
                                    </RadzenLineSeries>
                                }

                                <RadzenLineSeries Data="@ConsumptionCustomData"
                                                  Stroke="var(--sessy-radiation-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. global radiation")"
                                                  CategoryProperty="X"
                                                  ValueProperty="GlobalRadiation"
                                                  Hidden="true"
                                                  ValueAxisName="radiation"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>

                                <RadzenLineSeries Data="@ConsumptionCustomData"
                                                  Stroke="var(--sessy-humidity-line)"
                                                  StrokeWidth="2"
                                                  Title="@T("Avg. humidity")"
                                                  CategoryProperty="X"
                                                  ValueProperty="Humidity"
                                                  Hidden="true"
                                                  ValueAxisName="humidity"
                                                  LineType="LineType.Solid">
                                </RadzenLineSeries>
                            }

                            <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Date")" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                <RadzenGridLines Visible="true" />
                                <RadzenAxisTitle Text="@T("Wh")" />
                            </RadzenValueAxis>
                            @if (ShowWeather)
                            {
                                <RadzenValueAxis Name="temperature" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Celsius")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="radiation" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Watt / m2")" />
                                </RadzenValueAxis>
                                <RadzenValueAxis Name="humidity" Width="100" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                                    <RadzenAxisTitle Text="@T("Percentage")" />
                                </RadzenValueAxis>
                            }
                        </RadzenChart>
                    </RadzenCard>
                }
                </RadzenTabsItem>
                <RadzenTabsItem Text="@T("vs. previous year")">
                    <ConsumptionVarianceComponent Model="@_model"
                                                  Result="@Variance"
                                                  Fit="@ModelFit"
                                                  PeriodText="@VariancePeriodText"
                                                  CategoryTitle="@VarianceCategoryTitle"
                                                  Message="@VarianceMessage" />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenBody>
    <RadzenFooter>
        <RadzenLabel Text="@T("Total Consumption:")" Component="RadzenDropDownBindValue" class="m-2" />
        <RadzenNumeric Value="@TotalConsumptionKWh" ReadOnly="true" class="m-2" Format="0.00" Disabled ShowUpDown="false"/>

        <RadzenLabel Text="@T("Avg. temperature:")" Component="RadzenDropDownBindValue" class="m-2" />
        <RadzenNumeric Value="@AverageTemperature" ReadOnly="true" class="m-2" Format="0.0" Disabled ShowUpDown="false"/>

        <RadzenLabel Text="@T("Consumption vs. prev. year:")" Component="DeltaPreviousYear" class="m-2" />
        <RadzenTextBox Value="@DeltaPreviousYearText" ReadOnly="true" Disabled class="m-2" Style="width: 340px;" Name="DeltaPreviousYear" />
    </RadzenFooter>
</RadzenLayout>
