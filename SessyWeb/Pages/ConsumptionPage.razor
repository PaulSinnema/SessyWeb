@page "/consumption"
@inherits PageBase
@using System
@using SessyController.Services
@using SessyController.Services.Items
@using SessyWeb.Components
@using static SessyWeb.Components.DateChooserComponent

@code {
    bool ShowDataLabels = true;
    bool ShowMarkers = true;
}

<PageTitle>Consumption</PageTitle>

<RadzenLayout Style="height: 80vh;">
    <RadzenHeader Style="height: 100%;margin: 0px; padding: 0px;">
        <RadzenStack Orientation=Orientation.Horizontal AlignItems="AlignItems.Center" Style="height:100%;margin: 0px; padding: 0px;">
            @* TickDistance: <p>@TickDistance</p> *@

            <DateChooserComponent SelectionChanged="@((DateArgs d) => DateSelectionChanged(d))" CustomChooserEnabled="true" />

            <RadzenLabel Text="Show labels" Component="ShowDataLabels" />
            <RadzenCheckBox @bind-Value="@ShowDataLabels" Name="ShowDataLabels" />

            @if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Day)
            {
                <RadzenLabel Text="Show markers" Component="ShowMarkers" />
                <RadzenCheckBox @bind-Value="@ShowMarkers" Name="ShowMarkers" />
            }

        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        @if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Day)
        {
            <RadzenCard Style="@CardStyle">
                <RadzenLabel Text="Consumption" Component="RadzenDropDownBindValue" class="h4 m-2" />

                <RadzenChart Style="@GraphStyle" @ref=ConsumptionDayChart>
                    <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                    <RadzenAreaSeries Data="@ConsumptionDayData"
                    Stroke="var(--sessy-consumption-line)"
                    StrokeWidth="2"
                    Fill="var(--sessy-consumption-area)"
                    Title="Consumption"
                    CategoryProperty="Time"
                    ValueProperty="ConsumptionKWh"
                    Smooth="true"
                    LineType="LineType.Solid">
                        <ChildContent>
                            <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                            <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                        </ChildContent>
                    </RadzenAreaSeries>

                    <RadzenLineSeries Data="@ConsumptionDayData"
                    Stroke="var(--sessy-temperature-line)"
                    StrokeWidth="2"
                    Title="Temperature"
                    CategoryProperty="Time"
                    ValueProperty="Temperature"
                    ValueAxisName="temperature"
                    Smooth="true"
                    LineType="LineType.Dashed">
                        <ChildContent>
                            <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                        </ChildContent>
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionDayData"
                    Stroke="var(--sessy-solar-line)"
                    StrokeWidth="2"
                    Title="Global radiation"
                    CategoryProperty="Time"
                    ValueProperty="GlobalRadiation"
                    ValueAxisName="radiation"
                    Smooth="true"
                    LineType="LineType.Dashed">
                        <ChildContent>
                            <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                        </ChildContent>
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionDayData"
                    Stroke="var(--sessy-humidity-line)"
                    StrokeWidth="2"
                    Title="Humidity"
                    CategoryProperty="Time"
                    ValueProperty="Humidity"
                    ValueAxisName="humidity"
                    Smooth="true"
                    LineType="LineType.Dashed">
                        <ChildContent>
                            <RadzenMarkers Visible="@ShowMarkers" MarkerType="MarkerType.Circle" />
                        </ChildContent>
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Time" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Watt" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="temperature" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Celsius" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="radiation" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Watt / m2" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="humidity" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Percentage" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenCard>
        }
        else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Week)
        {
            <RadzenCard Style="@CardStyle">
                <RadzenChart Style="@GraphStyle" @ref=ConsumptionWeekChart >
                    <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                    <RadzenColumnSeries Data="@ConsumptionWeekData"
                    Stroke="var(--sessy-consumption-line)"
                    StrokeWidth="2"
                    Fill="var(--sessy-consumption-area)"
                    Title="Consumption"
                    CategoryProperty="DayOfWeek"
                    ValueProperty="ConsumptionKWh"
                    LineType="LineType.Solid">
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                        </ChildContent>
                    </RadzenColumnSeries>

                    <RadzenLineSeries Data="@ConsumptionWeekData"
                    Stroke="var(--sessy-temperature-line)"
                    StrokeWidth="2"
                    Title="Avg. temperature"
                    CategoryProperty="DayOfWeek"
                    ValueProperty="Temperature"
                    ValueAxisName="temperature"
                    LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionWeekData"
                    Stroke="var(--sessy-solar-line)"
                    StrokeWidth="2"
                    Title="Avg. global radiation"
                    CategoryProperty="DayOfWeek"
                    ValueProperty="GlobalRadiation"
                    ValueAxisName="radiation"
                    LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionWeekData"
                    Stroke="var(--sessy-humidity-line)"
                    StrokeWidth="2"
                    Title="Avg. humidity"
                    CategoryProperty="DayOfWeek"
                    ValueProperty="Humidity"
                    ValueAxisName="humidity"
                    LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45" Padding="20">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Day" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Watt" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="temperature" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Celsius" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="radiation" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Watt / m2" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="humidity" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Percentage" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenCard>
        }
        else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Month)
        {
            <RadzenCard Style="@CardStyle">
                <RadzenChart Style="@GraphStyle" @ref=ConsumptionMonthChart>
                    <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                    <RadzenColumnSeries Data="@ConsumptionMonthData"
                                        Stroke="var(--sessy-consumption-line)"
                                        StrokeWidth="2"
                                        Fill="var(--sessy-consumption-area)"
                                        Title="Consumption"
                                        CategoryProperty="DayOfWeek"
                                        ValueProperty="ConsumptionKWh"
                                        LineType="LineType.Solid">
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                        </ChildContent>
                    </RadzenColumnSeries>

                    <RadzenLineSeries Data="@ConsumptionMonthData"
                                        Stroke="var(--sessy-temperature-line)"
                                        StrokeWidth="2"
                                        Title="Avg. temperature"
                                        CategoryProperty="DayOfWeek"
                                        ValueProperty="Temperature"
                                        ValueAxisName="temperature"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionMonthData"
                                        Stroke="var(--sessy-solar-line)"
                                        StrokeWidth="2"
                                        Title="Avg. global radiation"
                                        CategoryProperty="DayOfWeek"
                                        ValueProperty="GlobalRadiation"
                                        ValueAxisName="radiation"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionMonthData"
                                        Stroke="var(--sessy-humidity-line)"
                                        StrokeWidth="2"
                                        Title="Avg. humidity"
                                        CategoryProperty="DayOfWeek"
                                        ValueProperty="Humidity"
                                        ValueAxisName="humidity"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Day" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Watt" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="temperature" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Celsius" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="radiation" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Watt / m2" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="humidity" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Percentage" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenCard>

        }
        else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Year)
        {
            <RadzenCard Style="@CardStyle">
                <RadzenChart Style="@GraphStyle" @ref=ConsumptionYearChart>
                    <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                    <RadzenColumnSeries Data="@ConsumptionYearData"
                                        Stroke="var(--sessy-consumption-line)"
                                        StrokeWidth="2"
                                        Fill="var(--sessy-consumption-area)"
                                        Title="Consumption"
                                        CategoryProperty="MonthOfYear"
                                        ValueProperty="ConsumptionKWh"
                                        LineType="LineType.Solid">
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                        </ChildContent>
                    </RadzenColumnSeries>

                    <RadzenLineSeries Data="@ConsumptionYearData"
                                        Stroke="var(--sessy-temperature-line)"
                                        StrokeWidth="2"
                                        Title="Avg. temperature"
                                        CategoryProperty="MonthOfYear"
                                        ValueProperty="Temperature"
                                        ValueAxisName="temperature"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionYearData"
                                        Stroke="var(--sessy-solar-line)"
                                        StrokeWidth="2"
                                        Title="Avg. global radiation"
                                        CategoryProperty="MonthOfYear"
                                        ValueProperty="GlobalRadiation"
                                        ValueAxisName="radiation"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionYearData"
                                        Stroke="var(--sessy-humidity-line)"
                                        StrokeWidth="2"
                                        Title="Avg. humidity"
                                        CategoryProperty="MonthOfYear"
                                        ValueProperty="Humidity"
                                        ValueAxisName="humidity"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Month" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Watt" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="temperature" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Celsius" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="radiation" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Watt / m2" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="humidity" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Percentage" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenCard>

        }
        else if(DateSelectionChosen!.PeriodChosen == PeriodsEnums.All)
        {
            <RadzenCard Style="@CardStyle">
                <RadzenChart Style="@GraphStyle" @ref=ConsumptionAllChart>
                    <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                    <RadzenColumnSeries Data="@ConsumptionAllData"
                                        Stroke="var(--sessy-consumption-line)"
                                        StrokeWidth="2"
                                        Fill="var(--sessy-consumption-area)"
                                        Title="Consumption"
                                        CategoryProperty="Year"
                                        ValueProperty="ConsumptionKWh"
                                        LineType="LineType.Solid">
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                        </ChildContent>
                    </RadzenColumnSeries>

                    <RadzenLineSeries Data="@ConsumptionAllData"
                                        Stroke="var(--sessy-temperature-line)"
                                        StrokeWidth="2"
                                        Title="Avg. temperature"
                                        CategoryProperty="Year"
                                        ValueProperty="Temperature"
                                        ValueAxisName="temperature"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionAllData"
                                        Stroke="var(--sessy-solar-line)"
                                        StrokeWidth="2"
                                        Title="Avg. global radiation"
                                        CategoryProperty="Year"
                                        ValueProperty="GlobalRadiation"
                                        ValueAxisName="radiation"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionAllData"
                                        Stroke="var(--sessy-humidity-line)"
                                        StrokeWidth="2"
                                        Title="Avg. humidity"
                                        CategoryProperty="Year"
                                        ValueProperty="Humidity"
                                        ValueAxisName="humidity"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Year" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Watt" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="temperature" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Celsius" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="radiation" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Watt / m2" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="humidity" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Percentage" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenCard>
        }
        else if (DateSelectionChosen!.PeriodChosen == PeriodsEnums.Custom)
        {
            <RadzenCard Style="@CardStyle">
                <RadzenChart Style="@GraphStyle" @ref=ConsumptionCustomChart>
                    <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                    <RadzenColumnSeries Data="@ConsumptionCustomData"
                                        Stroke="var(--sessy-consumption-line)"
                                        StrokeWidth="2"
                                        Fill="var(--sessy-consumption-area)"
                                        Title="Consumption"
                                        CategoryProperty="X"
                                        ValueProperty="ConsumptionKWh"
                                        LineType="LineType.Solid">
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="@ShowDataLabels" />
                        </ChildContent>
                    </RadzenColumnSeries>

                    <RadzenLineSeries Data="@ConsumptionCustomData"
                                        Stroke="var(--sessy-temperature-line)"
                                        StrokeWidth="2"
                                        Title="Avg. temperature"
                                        CategoryProperty="X"
                                        ValueProperty="Temperature"
                                        ValueAxisName="temperature"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionCustomData"
                                        Stroke="var(--sessy-solar-line)"
                                        StrokeWidth="2"
                                        Title="Avg. global radiation"
                                        CategoryProperty="X"
                                        ValueProperty="GlobalRadiation"
                                        ValueAxisName="radiation"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenLineSeries Data="@ConsumptionCustomData"
                                        Stroke="var(--sessy-humidity-line)"
                                        StrokeWidth="2"
                                        Title="Avg. humidity"
                                        CategoryProperty="X"
                                        ValueProperty="Humidity"
                                        ValueAxisName="humidity"
                                        LineType="LineType.Dashed">
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Formatter=@Formatter TickDistance=@TickDistance LabelAutoRotation="-45">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Date" />
                    </RadzenCategoryAxis>
                    <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Watt" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="temperature" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Celsius" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="radiation" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Watt / m2" />
                    </RadzenValueAxis>
                    <RadzenValueAxis Name="humidity" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                        <RadzenAxisTitle Text="Percentage" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenCard>
        }

    </RadzenBody>
    <RadzenFooter>
        <RadzenLabel Text="Total Consumption:" Component="RadzenDropDownBindValue" class="m-2" />
        <RadzenNumeric Value="@TotalConsumptionKWh" ReadOnly="true" class="m-2" Format="0.00" Disabled ShowUpDown="false"/>

        <RadzenLabel Text="Avg. temperature:" Component="RadzenDropDownBindValue" class="m-2" />
        <RadzenNumeric Value="@AverageTemperature" ReadOnly="true" class="m-2" Format="0.0" Disabled ShowUpDown="false"/>
    </RadzenFooter>
</RadzenLayout>
