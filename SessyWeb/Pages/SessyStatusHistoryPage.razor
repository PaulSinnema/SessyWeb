@page "/sessystatushistory"
@inherits PageBase
@using SessyData.Model
@using Radzen
@using static SessyWeb.Components.DateChooserComponent

<RadzenLayout Style="height: 100%;margin: 0px; padding: 0px;">
    <RadzenHeader Style="height: 100%;margin: 0px; padding: 0px;">
        <RadzenStack Orientation=Orientation.Horizontal AlignItems="AlignItems.Center" Style="height:100%;margin: 0px; padding: 0px;">
            <RadzenLabel Text="@T("History")" class="h4 m-2" />

            <DateChooserComponent SelectionChanged="@((DateArgs d) => DateSelectionChanged(d))" />

                <RadzenLabel>@(T("Battery:"))</RadzenLabel>

            <RadzenDropDown TValue="string"
                            @bind-Value="selectedBattery"
                            Data="@BatteryNames"
                            Placeholder="@T("Select battery")"
                            Change=@BatteryChanged
                            Style="width: 200px;" />

        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <RadzenDataGrid @ref="historyGrid"
                        Style="height: 100%;margin: 0px; padding: 0px;"
                        Data="@StatusHistoryList"
                        Context="data"
                        Count="@count"
                        LoadData="@LoadData"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        Responsive="true"
                        PageSize="20"
                        PagerHorizontalAlign="HorizontalAlign.Center">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(GroupedSessyStatus.Name)" Title="@T("Name")" SortOrder="SortOrder.Ascending" />
                <RadzenDataGridColumn Property="@nameof(GroupedSessyStatus.StartTime)" Title="@T("Start time")" SortOrder="SortOrder.Descending" />
                <RadzenDataGridColumn Property="@nameof(GroupedSessyStatus.EndTime)" Title="@T("End time")" />
                <RadzenDataGridColumn Property="@nameof(GroupedSessyStatus.DurationVisual)" Title="@T("Duration")" />
                <RadzenDataGridColumn Property="@nameof(GroupedSessyStatus.Status)" Title="@T("Status")" />
                <RadzenDataGridColumn Property="@nameof(GroupedSessyStatus.StatusDetails)" Title="@T("Details")" />
            </Columns>
        </RadzenDataGrid>
    </RadzenBody>
</RadzenLayout>