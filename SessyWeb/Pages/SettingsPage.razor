@page "/settings"
@inherits PageBase
@using SessyData.Model
@using Radzen
@using Radzen.Blazor

<RadzenLayout Style="height: 80vh;">
    <RadzenHeader Style="height: 100%; margin: 0px; padding: 0px;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="height:100%; margin: 0px; padding: 0px;">
            <RadzenLabel Text="@T("Settings")" class="h4 m-2" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody Style="margin: 8px; padding: 0px; overflow-y: auto;">
        <RadzenTabs RenderMode="TabRenderMode.Client">

            @* ── Investment Groups ─────────────────────────────────────────── *@
            <Tabs>
                @* ── Management Settings ───────────────────────────────────── *@
                <RadzenTabsItem Text="@T("Management Settings")" Icon="settings">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem; max-width: 900px;">

                        @if (_settings == null)
                        {
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                        }
                        else
                        {
                            @* ── Location ────────────────────────────────────── *@
                            <RadzenFieldset Text="@T("Location")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Latitude")" />
                                        <RadzenNumeric @bind-Value="_settings.Latitude" Format="F6" Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Longitude")" />
                                        <RadzenNumeric @bind-Value="_settings.Longitude" Format="F6" Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Timezone")" />
                                        <RadzenTextBox @bind-Value="_settings.TimeZone" Style="width:100%" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            @* ── Solar ───────────────────────────────────────── *@
                            <RadzenFieldset Text="@T("Solar")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Annual production (kWh)")" />
                                        <RadzenNumeric @bind-Value="_settings.SolarAnnualProductionKWh" Format="F0" Style="width:100%" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            @* ── Battery control ──────────────────────────────── *@
                            <RadzenFieldset Text="@T("Battery control")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Optimization strategy")" />
                                        <RadzenDropDown @bind-Value="_settings.Strategy"
                                                        Data="@_strategies"
                                                        TextProperty="Text"
                                                        ValueProperty="Value"
                                                        Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Battery control method")" />
                                        <RadzenDropDown @bind-Value="_settings.BatteryControlMethod"
                                                        Data="@_controlMethods"
                                                        TextProperty="Text"
                                                        ValueProperty="Value"
                                                        Style="width:100%" />
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            @T("Default: P1 grid target — balances the batteries.")
                                            <InfoTipComponent Text="@T("P1 grid target (recommended): every battery runs in NOM and follows the grid target on the P1 meter. The Sessy firmware then divides the power over all batteries itself and keeps them in balance, and it follows the real house load in real time. Setpoint per battery: SessyWeb sends each battery a fixed share of the power (by nameplate) on the Open API. Nothing balances the batteries then, so their state of charge can drift apart and one battery runs full or empty before the others; the setpoint also only changes once per control cycle, so changes in house load in between are not followed. Zero Net Home stays NOM in both methods; Hold reserve follows the solar surplus every 5 seconds in both.")" />
                                        </RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Minimum reserve (%)")" />
                                        <RadzenNumeric TValue="double" @bind-Value="_settings.FixedNightReservePct" Format="F0" Min="0" Max="100" Style="width:100%" />
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            @T("Default 0. Never discharge below this.")
                                            <InfoTipComponent Text="@T("Percent of capacity the planner never discharges below. Not needed to protect the cells — the batteries' BMS already does that — and not needed for the night either: the planner weighs covering the house at night against selling in the evening peak itself. Set it only if you want energy held back on purpose, for example as a buffer. Every percent above 0 is capacity the planner cannot use.")" />
                                        </RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Throttle fallback (%)")" />
                                        <RadzenNumeric TValue="double" @bind-Value="_settings.ThrottleFallbackPct" Format="F0" Min="0" Max="100" Style="width:100%" />
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            0 = 80%
                                            <InfoTipComponent Text="@T("Power cap used only while the throttle at the current temperature has not been measured yet. Once samples exist the measured ratio takes over. Assuming no throttle at all would make the planner ask for power the battery cannot deliver.")" />
                                        </RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Round-trip efficiency fallback (%)")" />
                                        <RadzenNumeric TValue="double" @bind-Value="_settings.RoundTripEfficiencyFallbackPct" Format="F0" Min="0" Max="100" Style="width:100%" />
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            0 = 90%
                                            <InfoTipComponent Text="@T("Round-trip energy efficiency used until enough charging and discharging has been measured. This is how much of the stored energy comes back out, which decides whether arbitrage pays at all — a different quantity from the throttle, which limits power. The planner derives the one-way efficiencies as the square root of this.")" />
                                        </RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4" Style="display:flex; flex-direction:column; gap:8px; justify-content:flex-end;">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.ChargedInControl" />
                                            <RadzenLabel Text="@T("Charged in control")" />
                                        </RadzenStack>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.ManualOverride" />
                                            <RadzenLabel Text="@T("Manual override")" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                                @if (_settings.ManualOverride)
                                {
                                    <RadzenRow Gap="1rem" Style="margin-top:1rem;">
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Manual charging hours")" />
                                            <RadzenDropDown @bind-Value="_chargingHours"
                                                            Data="@_allHours"
                                                            Multiple="true" AllowClear="true"
                                                            Placeholder="@T("— select hours —")" Style="width:100%"
                                                            Change="@(() => OnChargingHoursChanged())" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Manual discharging hours")" />
                                            <RadzenDropDown @bind-Value="_dischargingHours"
                                                            Data="@_allHours"
                                                            Multiple="true" AllowClear="true"
                                                            Placeholder="@T("— select hours —")" Style="width:100%"
                                                            Change="@(() => OnDischargingHoursChanged())" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Manual Zero Net Home hours")" />
                                            <RadzenDropDown @bind-Value="_nzhHours"
                                                            Data="@_allHours"
                                                            Multiple="true" AllowClear="true"
                                                            Placeholder="@T("— select hours —")" Style="width:100%"
                                                            Change="@(() => OnNzhHoursChanged())" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                }
                            </RadzenFieldset>

                            @* ── Planner tuning parameters ────────────────────── *@
                            <RadzenFieldset Text="@T("Diagnostics")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Record planner solve inputs")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Default: Off. Writes one JSON file per rebuild to the export directory.")
                                            <InfoTipComponent Text="@T("When on, the planner saves its exact solve input (prices, battery spec, options, SOC bounds) to the export directory on every rebuild, so a suspect plan can be replayed. The export directory must exist and, in Docker, be a mounted volume — otherwise the files land inside the container and are lost on restart. The SESSY_RECORD_SOLVE_INPUTS environment variable forces this on regardless of this switch.")" />
                                        </RadzenText>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.RecordSolveInputs" />
                                            <RadzenLabel Text="@T("Enabled")" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Solve inputs to keep")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Oldest files are pruned. Default: 20.")
                                            <InfoTipComponent Text="@T("How many solve-input files to keep in the export directory; the oldest are deleted beyond this count. 0 or less falls back to 20.")" />
                                        </RadzenText>
                                        <RadzenNumeric @bind-Value="_settings.SolveInputKeepFiles" Min="1" Max="500" Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Charged schedule history (days)")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Older quarters are pruned once a day. Default: 30.")
                                            <InfoTipComponent Text="@T("Every time Charged's schedule is read from the batteries, the quarters that changed are stored in the database, so Charged's plan can be compared with ours afterwards (Plan dump). This sets how many days of that history are kept. 0 or less falls back to 30.")" />
                                        </RadzenText>
                                        <RadzenNumeric @bind-Value="_settings.ChargedScheduleKeepDays" Min="1" Max="365" Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Export directory")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Where solve inputs are written. In Docker: a mounted volume.")
                                            <InfoTipComponent Text="@T("Absolute path the planner writes solve-input files to. It must exist; in Docker it must be inside a mounted volume, otherwise the files are lost when the container restarts.")" />
                                        </RadzenText>
                                        <RadzenTextBox @bind-Value="_settings.ExportDirectory" Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Developer options")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Default: Off. Shows developer-only tooling (the Plan dump tab).")
                                            <InfoTipComponent Text="@T("When on, the Plan dump tab becomes visible, with its plan snapshot and the past solve-input reconstruction. Off hides the whole tab.")" />
                                        </RadzenText>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.DeveloperOptions" Change="@((bool _) => StateHasChanged())" />
                                            <RadzenLabel Text="@T("Enabled")" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            @* ── Planner tuning parameters ────────────────────── *@
                            <RadzenFieldset Text="@T("Advanced planning parameters")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Cycle cost source")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("On = derive from investments. Off = use the fixed value.")
                                            <InfoTipComponent Text="@T("On: the wear cost per kWh is derived from the battery investments (cost / capacity / cycles). Off: the planner uses the fixed cycle cost below — set it to 0 to disable the wear cost entirely and trade on every profitable spread.")" />
                                        </RadzenText>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.UseCalculatedCycleCost" />
                                            <RadzenLabel Text="@T("Calculate from investments")" />
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Fixed cycle cost (€/kWh)")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Default: 0. Used when 'Calculate from investments' is off.")
                                            <InfoTipComponent Text="@T("Fixed battery wear cost per kWh, used only when 'Calculate from investments' is off. 0 disables the wear penalty; a higher value makes the planner more cautious about cycling.")" />
                                        </RadzenText>
                                        <RadzenNumeric TValue="double" @bind-Value="_settings.FixedCycleCostEurPerKWh" Format="0.000" Min="0" Max="1" Step="0.01" Style="width:100%" />
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12">
                                        <RadzenButton Text="@T("Reset to defaults")" Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                                      Click="@ResetPlannerDefaults" Style="margin-bottom:0.75rem" />
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Planning horizon (hours)")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("0 = no limit. Default: 0.")
                                            <InfoTipComponent Text="@T("Quarters beyond this many hours are ignored by the solver, so discharge cannot be deferred to a distant peak. Typical values are 24 or 36; 0 uses every quarter with a known price.")" />
                                        </RadzenText>
                                        <RadzenNumeric @bind-Value="_settings.PlanningHorizonHours" Style="width:100%" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Use predicted prices in the solver")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Default: Off.")
                                            <InfoTipComponent Text="@T("Off uses published prices only, which keeps the horizon short; predicted quarters still extend it for night coverage but are never traded. Soft trades predicted quarters with a risk margin, so only wide spreads are acted on. Full trusts predicted prices exactly like published ones.")" />
                                        </RadzenText>
                                        <RadzenDropDown @bind-Value="_settings.PredictedPriceMode"
                                                        Data="@_predictedPriceModes"
                                                        TextProperty="Text"
                                                        ValueProperty="Value"
                                                        Change="@(_ => StateHasChanged())"
                                                        Style="width:100%" />
                                    </RadzenColumn>
                                    @if (_settings.PredictedPriceMode == PredictedPriceMode.SoftMargin)
                                    {
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Predicted price risk margin (€/kWh)")" />
                                            <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                                @T("Default: 0.05.")
                                                <InfoTipComponent Text="@T("Widens the spread on predicted quarters: their buy price is raised and their sell price lowered by this amount, so the solver only arbitrages a predicted quarter when the gain is comfortably larger than the price uncertainty.")" />
                                            </RadzenText>
                                            <RadzenNumeric @bind-Value="_settings.PredictedPriceRiskMarginEur" Format="F4" Step="0.01" Min="0" Style="width:100%" />
                                        </RadzenColumn>
                                    }
                                </RadzenRow>
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenLabel Text="@T("Future value discount (%/hour)")" />
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Time preference. 0 = off. Default: 0.3.")@(_settings.SelfLearningEnabled ? T(" · learned nightly") : "")
                                            <InfoTipComponent Text="@T("How much less a quarter is worth per hour of distance when the planner decides where to send stored energy: a peak 24h out has to be that much better to still beat an equally reachable one tonight. Only affects planning — the executed plan and the reported profit use real prices. 0 turns it off, and a single distant peak can claim the whole battery again. The default of 0.3% comes from measured plan stability: 94-97% of planned modes still hold up to 18h ahead. Raise it if you switch predicted prices on for trading, because beyond 24h plans hold only 23-63%. With self-learning on, the nightly fit replaces this value as soon as it has 21 days of forecasts to measure; until then whatever you set here is kept.")" />
                                        </RadzenText>
                                        <RadzenNumeric TValue="double" Value="@(_settings.FutureValueDiscountPerHour * 100.0)"
                                                       ValueChanged="@(v => _settings.FutureValueDiscountPerHour = v / 100.0)"
                                                       Format="F2" Min="0" Style="width:100%" />
                                    </RadzenColumn>
                                </RadzenRow>

                                @* ── Carry-forward ───────────────────────────── *@
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.CarryForwardEnabled" Change="@((bool _) => StateHasChanged())" />
                                            <RadzenLabel Text="@T("Allow carry-forward past the horizon")" />
                                            <InfoTipComponent Text="@T("Lets the planner charge purely to hold energy past the end of its horizon, valued at the measured replacement cost. Without it every charge must be paired with a discharge the planner can already see, so a cheap or negative price whose payoff lies further out is worth nothing to it. Changes what the battery buys, so it is off unless you switch it on.")" />
                                        </RadzenStack>
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">@(T("Charge now for a payoff beyond the plan. Default: off."))</RadzenText>
                                    </RadzenColumn>
                                    @if (_settings.CarryForwardEnabled)
                                    {
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Replacement cost window (days)")" />
                                            <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                                @T("Default: 30.")
                                                <InfoTipComponent Text="@T("Trailing window the cheapest all-in buy price of each day is taken from. Longer means a steadier number that reacts slowly to a change of season; shorter follows the current market but is noisier. Days with an incomplete set of prices are skipped.")" />
                                            </RadzenText>
                                            <RadzenNumeric @bind-Value="_settings.ReplacementCostWindowDays" Min="7" Style="width:100%" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Replacement cost percentile")" />
                                            <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                                @T("Keep it low. Default: 25.")
                                                <InfoTipComponent Text="@T("Which percentile of those daily cheapest prices becomes the replacement cost. It answers the question: on most days, how cheaply can I buy a kWh? Low on purpose — set too high, charging is always attractive and selling never is, and the battery ends up full and idle. The result is additionally capped at the median buy price of the same window.")" />
                                            </RadzenText>
                                            <RadzenNumeric @bind-Value="_settings.ReplacementCostPercentile" Format="F0" Min="1" Max="99" Style="width:100%" />
                                        </RadzenColumn>
                                    }
                                </RadzenRow>

                                @* ── Shift discharge ─────────────────────────── *@
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.ShiftDischargeEnabled" />
                                            <RadzenLabel Text="@T("Allow moving discharge between quarters")" />
                                            <InfoTipComponent Text="@T("Lets the planner sell stored energy in an expensive quarter and, in return, not cover the house from the battery in a cheaper quarter later (the house then imports). The energy is already stored, so no round trip is lost; the planner only does it when it pays at least 1 cent per kWh after the efficiency loss of low-power quarters. Side effect: the battery reaches the minimum reserve more often and earlier in the evening, and quarters given up show as Hold reserve. Off unless you switch it on.")" />
                                        </RadzenStack>
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">@(T("Sell in the peak, import for the house when it is cheaper. Default: off."))</RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>

                                @* ── Self-learning ───────────────────────────── *@
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.SelfLearningEnabled" Change="@((bool _) => StateHasChanged())" />
                                            <RadzenLabel Text="@T("Learn the future value discount from measured forecast error")" />
                                            <InfoTipComponent Text="@T("Runs once a night over 21 days of stored forecasts and what actually happened, and overwrites the future value discount above. The discount comes from how much the combined solar and consumption forecast drifts with lead time. Until there is enough history it writes nothing at all and the field keeps whatever you set, so you can still tune it by hand in the meantime. A learned value that lands on its bound is reported under Tips and Checks instead of being applied silently.")" />
                                        </RadzenStack>
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Nightly fit; overwrites the discount above once it has data. Default: off.")
                                        </RadzenText>
                                    </RadzenColumn>
                                    @if (_settings.LastLearnedAt.HasValue)
                                    {
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenLabel Text="@T("Last learned")" />
                                            <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                                @_settings.LastLearnedAt.Value.ToString("dd-MM-yyyy HH:mm")<br />
                                                @_settings.LastLearnedSummary
                                            </RadzenText>
                                        </RadzenColumn>
                                    }
                                </RadzenRow>
                            </RadzenFieldset>

                            @* ── Energy needs per month ───────────────────────── *@
                            <RadzenFieldset Text="@T("Estimated home energy needs per day (Wh), per month")">
                                <RadzenRow Gap="0.5rem">
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        int month = m;
                                        <RadzenColumn Size="6" SizeMD="2">
                                            <RadzenLabel Text="@_monthNames[month]" />
                                            <RadzenNumeric Value="@_energyNeeds[month]"
                                                           ValueChanged="@((double v) => _energyNeeds[month] = v)"
                                                           Format="F0" Style="width:100%" />
                                        </RadzenColumn>
                                    }
                                </RadzenRow>
                            </RadzenFieldset>

                            @* ── Statistics ───────────────────────────────────── *@
                            <RadzenFieldset Text="@T("Statistics")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenLabel Text="@T("Statistics from date (optional)")" />
                                        <RadzenDatePicker @bind-Value="_settings.StatisticsFromDate"
                                                          DateFormat="dd-MM-yyyy"
                                                          AllowClear="true"
                                                          Placeholder="@T("— all history —")"
                                                          Style="width:100%" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            <RadzenRow>
                                <RadzenColumn>
                                    <RadzenButton Text="@T("Save")" Icon="save"
                                                  ButtonStyle="ButtonStyle.Success"
                                                  Click="@SaveSettingsAsync"
                                                  IsBusy="@_settingsSaving" />
                                    @if (_settingsSaved)
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" Style="margin-left:1rem; color:var(--sessy-positive-text);">
                                            @T("✓ Saved")
                                        </RadzenText>
                                    }
                                </RadzenColumn>
                            </RadzenRow>
                        }

                    </RadzenStack>
                </RadzenTabsItem>

                @* ── User interface ────────────────────────────────────────── *@
                <RadzenTabsItem Text="@T("User interface")" Icon="display_settings">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem; max-width: 900px;">

                        @if (_settings == null)
                        {
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                        }
                        else
                        {
                            <RadzenFieldset Text="@T("Navigation menu")">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
                                            <RadzenCheckBox @bind-Value="_settings.KeepMenuExpanded" />
                                            <RadzenLabel Text="@T("Keep the menu expanded after clicking an item")" />
                                            <InfoTipComponent Text="@T("With this on, the menu stays as you left it with the toggle above it: expanded menus keep showing their labels while you move from page to page. With it off, every click folds the menu back to icons only, which is how it worked before. On a phone the expanded menu covers part of the page, so switch it off there if the icons suit you better.")" />
                                        </RadzenStack>
                                        <RadzenText TextStyle="TextStyle.Caption" style="color:var(--rz-text-secondary-color)">
                                            @T("Default: on. Applies to every browser that opens this application.")
                                        </RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            <RadzenRow>
                                <RadzenColumn>
                                    <RadzenButton Text="@T("Save")" Icon="save"
                                                  ButtonStyle="ButtonStyle.Success"
                                                  Click="@SaveSettingsAsync"
