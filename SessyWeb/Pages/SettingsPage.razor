                @* ── Tips & Checks ──────────────────────────────────────────── *@
                <RadzenTabsItem Text="@T("Tips & Checks")" Icon="tips_and_updates" data-sessy-badge="@ChecksTabBadge">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="padding: 1rem; max-width: 900px;">
                        @if (_checks == null)
                        {
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                        }
                        else if (!_checks.Any())
                        {
                            <RadzenText TextStyle="TextStyle.Body1">✅ @(T("All checks passed — no issues found."))</RadzenText>
                        }
                        else
                        {
                            @foreach (var check in _checks)
                            {
                                <RadzenCard Style="@($"border-left: 4px solid {CheckColor(check.Severity)}; padding: 1rem;")">
                                    <RadzenText TextStyle="TextStyle.Subtitle1">
                                        @check.SeverityIcon @check.Title
                                    </RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin-top: 0.25rem; opacity: 0.85;">
                                        @check.Description
                                    </RadzenText>
                                    @if (check.ActionUrl != null)
                                    {
                                        <a href="@check.ActionUrl" target="_blank" style="font-size: 0.85rem; margin-top: 0.5rem; display: inline-block;">
                                            @(check.ActionLabel ?? check.ActionUrl)
                                        </a>
                                    }
                                </RadzenCard>
                            }
                        }
                    </RadzenStack>
                </RadzenTabsItem>

                @* ── Notifications ──────────────────────────────────────────── *@
                <RadzenTabsItem Text="@T("Notifications")" Icon="notifications" data-sessy-badge="@NotificationsTabBadge">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem; max-width: 900px;">

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
                                Notifications
                                @if (NotificationUnread > 0)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@NotificationUnread.ToString()" Style="margin-left: 0.5rem;" />
                                }
                            </RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="@T("Mark all read")" Icon="mark_email_read" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small" Click="@MarkAllNotificationsReadAsync"
                                              Disabled="@(_notifications == null || NotificationUnread == 0)" />
                                <RadzenButton Text="@T("Delete all")" Icon="delete_sweep" ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small" Click="@DeleteAllNotificationsAsync"
                                              Disabled="@(_notifications == null || !_notifications.Any())" />
                            </RadzenStack>
                        </RadzenStack>

                        @if (_notifications != null && _notifications.Any())
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenDropDown TValue="SessyData.Model.NotificationSeverity?" @bind-Value="_notifSeverityFilter"
                                                Data="@(Enum.GetValues<SessyData.Model.NotificationSeverity>())" AllowClear="true"
                                                Placeholder="@T("All severities")" Style="min-width: 180px;" />
                                <RadzenDropDown TValue="string" @bind-Value="_notifCategoryFilter"
                                                Data="@NotificationCategories" AllowClear="true"
                                                Placeholder="@T("All categories")" Style="min-width: 180px;" />
                            </RadzenStack>
                        }

                        @if (_notifications == null)
                        {
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                        }
                        else if (!_notifications.Any())
                        {
                            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem; opacity: 0.7;">
                                <RadzenIcon Icon="notifications_none" Style="font-size: 3rem;" />
                                <RadzenText TextStyle="TextStyle.Body1">@(T("No notifications."))</RadzenText>
                            </RadzenStack>
                        }
                        else
                        {
                            @if (!FilteredNotifications.Any())
                            {
                                <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.7;">@(T("No notifications match the filter."))</RadzenText>
                            }
                            @foreach (var n in FilteredNotifications)
                            {
                                <RadzenCard Style="@($"border-left: 5px solid {NotificationColor(n.Severity)}; padding: 0.9rem 1rem; {(n.IsRead ? "opacity: 0.6;" : "")}")">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="0.75rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                                            <RadzenIcon Icon="@NotificationIcon(n.Severity)" Style="@($"font-size: 1.6rem; color: {NotificationColor(n.Severity)};")" />
                                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.3rem">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0;">@n.Title</RadzenText>
                                                    @if (n.Count > 1)
                                                    {
                                                        <RadzenBadge BadgeStyle="BadgeStyle.Base" IsPill="true" Text="@($"×{n.Count}")" title="@T("Occurred {0} times", n.Count)" />
                                                    }
                                                    <RadzenBadge BadgeStyle="@NotificationBadgeStyle(n.Severity)" Text="@n.Severity.ToString()" IsPill="true" />
                                                    @if (!string.IsNullOrEmpty(n.Category))
                                                    {
                                                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@n.Category" IsPill="true" />
                                                    }
                                                </RadzenStack>
                                                <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.9; margin: 0;">@n.Message</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.6; margin: 0;">
                                                    @n.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                                                </RadzenText>
                                            </RadzenStack>
                                        </RadzenStack>
                                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                      Size="ButtonSize.Small" title="@T("Delete this notification")"
                                                      Click="@(() => DeleteNotificationAsync(n.Id))" />
                                    </RadzenStack>
                                </RadzenCard>
                            }
                        }
                    </RadzenStack>
                </RadzenTabsItem>

                @* ── SQL Console ────────────────────────────────────────────── *@
                @if (_settings?.DeveloperOptions == true)
                {
                <RadzenTabsItem Text="@T("Plan dump")" Icon="bug_report">
                    <div style="display:flex; flex-direction:column; padding:1rem; gap:0.75rem; max-width:640px;">
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity:0.7; margin:0;">
                            @T("Downloads a JSON snapshot with everything needed to analyse a plan for the chosen period: planner settings, EPEX prices, taxes, planned quarters, actual quarters and measured facts. The file is built in memory and offered for download — it is never written to disk.")
                        </RadzenText>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:flex-end;">
                            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                <RadzenText TextStyle="TextStyle.Caption" Style="margin:0;">@(T("From"))</RadzenText>
                                <RadzenDatePicker @bind-Value="_dumpFrom" ShowTime="true" DateFormat="yyyy-MM-dd HH:mm" />
                            </div>
                            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                <RadzenText TextStyle="TextStyle.Caption" Style="margin:0;">@(T("To"))</RadzenText>
                                <RadzenDatePicker @bind-Value="_dumpTo" ShowTime="true" DateFormat="yyyy-MM-dd HH:mm" />
                            </div>
                            <RadzenButton Text="@T("Download dump")" Icon="download"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@DownloadPlanDumpAsync"
                                          IsBusy="@_dumpBusy" />
                        </div>
                        @if (_dumpError != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">@_dumpError</RadzenAlert>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:1rem 0 0 0;">@(T("Reconstruct a past solve-input"))</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity:0.7; margin:0;">
                            @T("Rebuilds the planner input for the period above from the database and downloads it, to replay a plan that ran before solve-input recording was on.")
                            <InfoTipComponent Text="@T("Approximate: prices, net load and the reserve floor are exact from the stored plan, and the initial SOC from the measurement, but the battery spec and planner options are the CURRENT ones, not as they were then. Only reaches back as far as the plan history goes.")" />
                        </RadzenText>
                        <div>
                            <RadzenButton Text="@T("Reconstruct & download")" Icon="history"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Click="@DownloadReconstructedSolveInputAsync"
                                          IsBusy="@_reconstructBusy" />
                        </div>
                        @if (_reconstructError != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">@_reconstructError</RadzenAlert>
                        }
                    </div>
                </RadzenTabsItem>
                }

                @* ── SQL Console ────────────────────────────────────────────── *@
                <RadzenTabsItem Text="@T("SQL Console")" Icon="terminal">
                    <div style="display:flex; flex-direction:column; padding:1rem; gap:0.5rem;">
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity:0.7; margin:0;">
                            @T("Direct SQL access. Everything is allowed — be careful!")
                            <InfoTipComponent Text="@T("Multiple statements separated by semicolons run in order on one connection and inside one transaction, so temp tables carry over and a failure halfway rolls everything back. sqlite3 dot-commands and BEGIN/COMMIT are skipped. The grid shows the last result set. Take a backup before running anything destructive.")" />
                        </RadzenText>
                        <div style="display:flex; gap:0.5rem; align-items:flex-start;">
                            <RadzenTextArea @bind-Value="_sqlStatement"
                                            Rows="4"
                                            Style="flex:1; font-family:monospace; resize:vertical;"
                                            Placeholder="@T("SELECT * FROM QuarterlyMeasurements WHERE SolarProductionKwh > 100;")" />
                            <div style="display:flex; flex-direction:column; gap:0.5rem;">
                                <RadzenButton Text="@T("Execute")" Icon="play_arrow"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@ExecuteSqlAsync"
                                              IsBusy="@_sqlBusy" />
                                <RadzenButton Text="@T("Backup")" Icon="save"
                                              ButtonStyle="ButtonStyle.Warning"
                                              Click="@BackupDatabaseAsync"
                                              IsBusy="@_sqlBackupBusy"
                                              title="@T("Writes a VACUUM INTO copy of the database to the backup directory. Do this before running anything destructive.")" />
                                <RadzenButton Text="@T("Clear")" Icon="clear"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => { _sqlStatement = string.Empty; _sqlResult = null; _sqlError = null; _sqlBackupMessage = null; })" />
                                <RadzenButton Text="@T("CSV")" Icon="download"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Disabled="@(_sqlResult == null || _sqlResult.Count == 0)"
                                              Click="@ExportCsvAsync" />
                                <RadzenButton Text="@T("Excel")" Icon="table_view"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Disabled="@(_sqlResult == null || _sqlResult.Count == 0)"
                                              Click="@ExportXlsxAsync" />
                            </div>
                        </div>
                        @if (_sqlBackupMessage != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true">@_sqlBackupMessage</RadzenAlert>
                        }
                        @if (_sqlError != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">@_sqlError</RadzenAlert>
                        }
                        @if (_sqlResult != null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption">@_sqlRowsAffected</RadzenText>
                            @if (_sqlResult.Count > 0)
                            {
                                <div style="overflow-x:auto;">
                                    <RadzenDataGrid Data="@_sqlResult" TItem="Dictionary<string, object>"
                                                    AllowSorting="false" AllowPaging="true"
                                                    PageSize="15"
                                                    PagerHorizontalAlign="HorizontalAlign.Left"
                                                    Style="width:100%;">
                                        <Columns>
                                            @foreach (var col in _sqlColumns)
                                            {
                                                var c = col;
                                                <RadzenDataGridColumn TItem="Dictionary<string, object>" Title="@c">
                                                    <Template Context="row">
                                                        @(row.TryGetValue(c, out var v) ? v?.ToString() ?? "NULL" : "")
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            }
                                        </Columns>
                                    </RadzenDataGrid>
                                </div>
                            }
                        }
                    </div>
                </RadzenTabsItem>

                @* ── Credits ───────────────────────────────────────────────── *@
                <RadzenTabsItem Text="@T("Credits")" Icon="favorite">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="2rem" Style="padding: 1.5rem; max-width: 900px;">

                        @* -- Section: Hard- and software -- *@
                        <RadzenText TextStyle="TextStyle.H5" Style="margin-bottom: 0.5rem;">
                            <RadzenIcon Icon="devices" Style="vertical-align: middle; margin-right: 6px;" />
                            @T("Hard- and software")
                        </RadzenText>
                        <RadzenRow Gap="1rem">

                            @* Charged *@
                            <RadzenColumn SizeSM="3">
                                <RadzenCard class="rz-background-color-primary" Style="height:100%; text-align:center; padding: 1.25rem;">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary" Style="display:block; margin-bottom:0.75rem; opacity:0.7;">@(T("Hardware"))</RadzenText>
                                    <a href="https://charged.nu/" target="_blank" Style="display:block; margin-bottom:0.75rem;">
                                        <RadzenImage Path="/Images/Charged_transparent_final.png"
                                                     Style="width:90px; height:60px; object-fit:contain; background:transparent;" />
                                    </a>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-primary"><b>@(T("Charged B.V."))</b></RadzenText>
                                </RadzenCard>
                            </RadzenColumn>

                            @* Sessy *@
                            <RadzenColumn SizeSM="3">
                                <RadzenCard class="rz-background-color-primary" Style="height:100%; text-align:center; padding: 1.25rem;">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary" Style="display:block; margin-bottom:0.75rem; opacity:0.7;">@(T("Battery communication"))</RadzenText>
                                    <a href="https://sessy.nl/" target="_blank" Style="display:block; margin-bottom:0.75rem;">
                                        <RadzenImage Path="/Images/sessy.svg"
                                                     Style="width:90px; height:60px; object-fit:contain; background:transparent;" />
                                    </a>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-primary"><b>@(T("Sessy"))</b></RadzenText>
                                </RadzenCard>
                            </RadzenColumn>

                            @* Microsoft *@
                            <RadzenColumn SizeSM="3">
                                <RadzenCard class="rz-background-color-primary" Style="height:100%; text-align:center; padding: 1.25rem;">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary" Style="display:block; margin-bottom:0.75rem; opacity:0.7;">.@(T("NET development"))</RadzenText>
                                    <a href="https://microsoft.com/" target="_blank" Style="display:block; margin-bottom:0.75rem;">
                                        <RadzenImage Path="/Images/Microsoft.jpg"
                                                     Style="width:90px; height:60px; object-fit:contain; background:transparent;" />
                                    </a>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-primary"><b>@(T("Microsoft"))</b></RadzenText>
                                </RadzenCard>
                            </RadzenColumn>

                            @* Radzen *@
                            <RadzenColumn SizeSM="3">
                                <RadzenCard class="rz-background-color-primary" Style="height:100%; text-align:center; padding: 1.25rem;">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary" Style="display:block; margin-bottom:0.75rem; opacity:0.7;">@(T("UI web components"))</RadzenText>
                                    <a href="https://radzen.com/" target="_blank" Style="display:block; margin-bottom:0.75rem;">
                                        <RadzenImage Path="/Images/Radzen_transparent_final.png"
                                                     Style="width:50px; height:60px; object-fit:contain; background:transparent;" />
                                    </a>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-primary"><b>@(T("Radzen (free)"))</b></RadzenText>
                                </RadzenCard>
                            </RadzenColumn>

                        </RadzenRow>

                        @* -- Section: Online services -- *@
                        <RadzenText TextStyle="TextStyle.H5" Style="margin-bottom: 0.5rem; margin-top: 0.5rem;">
                            <RadzenIcon Icon="cloud" Style="vertical-align: middle; margin-right: 6px;" />
                            @T("Online services")
                        </RadzenText>
                        <RadzenRow Gap="1rem">

                            @* Weeronline *@
                            <RadzenColumn SizeSM="3">
                                <RadzenCard class="rz-background-color-primary" Style="height:100%; text-align:center; padding: 1.25rem;">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary" Style="display:block; margin-bottom:0.75rem; opacity:0.7;">@(T("Weather service"))</RadzenText>
                                    <a href="https://weeronline.nl" target="_blank" Style="display:block; margin-bottom:0.75rem;">
                                        <RadzenImage Path="/Images/wol_logo_white.svg"
                                                     Style="width:90px; height:60px; object-fit:contain;" />
                                    </a>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-primary"><b>@(T("Weeronline"))</b></RadzenText>
                                </RadzenCard>
                            </RadzenColumn>

                            @* Enever.nl *@
                            <RadzenColumn SizeSM="3">
                                <RadzenCard class="rz-background-color-primary" Style="height:100%; text-align:center; padding: 1.25rem;">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-on-primary" Style="display:block; margin-bottom:0.75rem; opacity:0.7;">@(T("Gas price feed"))</RadzenText>
                                    <a href="https://enever.nl" target="_blank" Style="display:block; margin-bottom:0.75rem;">
                                        <RadzenImage Path="/Images/enever.svg"
                                                     Style="width:120px; height:60px; object-fit:contain; background:transparent;" />
                                    </a>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-primary"><b>@(T("Enever.nl"))</b></RadzenText>
                                </RadzenCard>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenStack>
                </RadzenTabsItem>

                @* ── Container log ─────────────────────────────────────────── *@
                <RadzenTabsItem Text="@T("Container log")" Icon="terminal">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="padding: 1rem; height: 70vh;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                            <RadzenCheckBox @bind-Value="_logAutoScroll" Name="logAutoScroll" />
                            <RadzenLabel Text="@T("Auto-scroll")" Component="logAutoScroll" />
                            <RadzenLabel Text="@T("Level")" />
                            <RadzenDropDown TValue="Microsoft.Extensions.Logging.LogLevel" Data="@_logLevels" @bind-Value="_logMinLevel" Change="@(args => RefreshLogNow())" Style="width: 130px;" />
                            
                            <RadzenButton Text="@T("Copy")" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@CopyLog" />
                            <RadzenButton Text="@T("Export")" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ExportLog" />
                            <RadzenButton Text="@T("Clear")" Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ClearLog" />
                        </RadzenStack>
                        <pre @ref="_logContainer" style="flex: 1 1 auto; min-height: 0; overflow: auto; background: var(--sessy-terminal-bg); color: var(--sessy-terminal-fg); font-family: Consolas, 'Courier New', monospace; font-size: 12px; line-height: 1.35; padding: 8px; margin: 0; white-space: pre; border-radius: 4px;">@_logText</pre>
                    </RadzenStack>
                </RadzenTabsItem>

            </Tabs>
        </RadzenTabs>
    </RadzenBody>
</RadzenLayout>
