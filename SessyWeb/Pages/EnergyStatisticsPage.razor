@page "/energyStatistics"
@inherits PageBase
@using SessyController.Services.Statistics
@using SessyWeb.Components
@using Radzen
@using Radzen.Blazor
@using static SessyWeb.Components.DateChooserComponent

<style>
    /* Make every card stretch to the full height of its column so cards in the
           same row line up evenly instead of leaving ragged gaps. */
    .rz-display-flex {
        display: flex;
    }

        .rz-display-flex > .rz-card {
            width: 100%;
            height: 100%;
        }
</style>

<RadzenLayout Style="height: 80vh;">
    <RadzenHeader Style="height: 100%; margin: 0px; padding: 0px;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="height:100%; margin: 0px; padding: 0px;">
            <RadzenLabel Text="Energy Statistics" class="h4 m-2" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody Style="margin: 8px; padding: 0px; overflow-y: auto;">
        @* Without this the page always ran on the whole history, so its figures could never be
           compared with the Consumption or Solar power page, which do have a period. The handler
           was already here — only the chooser itself was missing. *@
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2" AlignItems="AlignItems.Start"
                     Style="width: 100%; margin-bottom: 8px;">
            <DateChooserComponent SelectionChanged="@((DateArgs d) => OnDateRangeChanged(d))" />
        </RadzenStack>

        @if (IsLoading)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Dashboard != null)
        {
            <RadzenRow Gap="12px" RowGap="12px" AlignItems="AlignItems.Stretch">

                <RadzenColumn Size="12" class="rz-display-flex">
                    <ReturnOnInvestmentComponent Dashboard="@Dashboard" />
                </RadzenColumn>

                @if (Dashboard.HeatPumpIsConfigured)
                {
                    <RadzenColumn Size="12" class="rz-display-flex">
                        <HeatPumpSavingsComponent Dashboard="@Dashboard" />
                    </RadzenColumn>
                }

                <RadzenColumn Size="12" class="rz-display-flex">
                    <EnergySystemSavingsComponent Dashboard="@Dashboard" />
                </RadzenColumn>

                @if (Dashboard.Plan != null)
                {
                    <RadzenColumn Size="12" class="rz-display-flex">
                        <CurrentPlanComponent Dashboard="@Dashboard"
                                              OnClearPlanAsync="@ClearPlanAsync"
                                              OnForceNewPlanAsync="@ForceNewPlanAsync" />
                    </RadzenColumn>
                }

                <RadzenColumn Size="12" class="rz-display-flex">
                    <CostBasisComponent />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" class="rz-display-flex">
                    <EnergyFlowsComponent Dashboard="@Dashboard" />
                </RadzenColumn>

                @if (Dashboard.DailyArbitrageTrends.Any())
                {
                    <RadzenColumn Size="12" SizeMD="6" class="rz-display-flex">
                        <DailyArbitrageChartComponent Dashboard="@Dashboard" />
                    </RadzenColumn>
                }

                <RadzenColumn Size="12" SizeMD="6" class="rz-display-flex">
                    <PlanVsActualComponent Dashboard="@Dashboard" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6" class="rz-display-flex">
                    <ThrottleChartComponent />
                </RadzenColumn>

            </RadzenRow>
        }
    </RadzenBody>
</RadzenLayout>
