@using SessyController.Services.Statistics
@using SessyWeb.Components
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H6">🔥 @T("Heat Pump Savings")</RadzenText>
    <RadzenRow Gap="8px">
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Gas price")"
                               Value="@($"€ {Dashboard!.HeatPump.GasPriceEurPerM3:F4}/m³")"
                               Highlight="@Dashboard!.HeatPump.IsLiveGasPrice" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Annual gas (before heat pump)")"
                               Value="@T("{0:F0} m³/year", Dashboard!.HeatPump.AnnualGasConsumptionM3)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Annual gas cost saved")"
                               Value="@T("€ {0:F2}/year", Dashboard!.HeatPump.AnnualGasCostSavedEur)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Standing charge saved")"
                               Value="@T("€ {0:F2}/year", Dashboard!.HeatPump.GasStandingChargeEurPerYear)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Heat pump electricity")"
                               Value="@T("{0:F0} kWh/year", Dashboard!.HeatPump.AnnualElectricityConsumptionKWh)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Electricity price (avg)")"
                               Value="@($"€ {Dashboard!.HeatPump.EffectiveElectricityPriceEurPerKWh:F4}/kWh")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Annual electricity cost")"
                               Value="@T("€ {0:F2}/year", Dashboard!.HeatPump.AnnualElectricityCostEur)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Net annual savings")"
                               Value="@T("€ {0:F2}/year", Dashboard!.HeatPump.NetAnnualSavingsEur)"
                               Highlight="true" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenText TextStyle="TextStyle.Caption" Style="margin-top: 0.75rem; opacity: 0.7;">
        @T(Dashboard!.HeatPump.GasPriceSource, Dashboard.HeatPump.GasPriceSourceArgs)
    </RadzenText>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public DashboardStatistics? Dashboard { get; set; }
}
