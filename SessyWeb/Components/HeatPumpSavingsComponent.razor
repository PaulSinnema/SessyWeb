@using SessyController.Services.Statistics
@using SessyWeb.Components
@using Radzen
@using Radzen.Blazor

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H6">🔥 Heat Pump Savings</RadzenText>
    <RadzenRow Gap="8px">
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Gas price"
                               Value="@($"€ {Dashboard!.HeatPump.GasPriceEurPerM3:F4}/m³")"
                               Highlight="@Dashboard!.HeatPump.IsLiveGasPrice" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Annual gas (before heat pump)"
                               Value="@($"{Dashboard!.HeatPump.AnnualGasConsumptionM3:F0} m³/year")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Annual gas cost saved"
                               Value="@($"€ {Dashboard!.HeatPump.AnnualGasCostSavedEur:F2}/year")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Standing charge saved"
                               Value="@($"€ {Dashboard!.HeatPump.GasStandingChargeEurPerYear:F2}/year")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Heat pump electricity"
                               Value="@($"{Dashboard!.HeatPump.AnnualElectricityConsumptionKWh:F0} kWh/year")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Electricity price (avg)"
                               Value="@($"€ {Dashboard!.HeatPump.EffectiveElectricityPriceEurPerKWh:F4}/kWh")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Annual electricity cost"
                               Value="@($"€ {Dashboard!.HeatPump.AnnualElectricityCostEur:F2}/year")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="Net annual savings"
                               Value="@($"€ {Dashboard!.HeatPump.NetAnnualSavingsEur:F2}/year")"
                               Highlight="true" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenText TextStyle="TextStyle.Caption" Style="margin-top: 0.75rem; opacity: 0.7;">
        @Dashboard!.HeatPump.GasPriceSource
    </RadzenText>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public DashboardStatistics? Dashboard { get; set; }
}
