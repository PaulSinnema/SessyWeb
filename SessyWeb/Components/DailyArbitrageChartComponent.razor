@using SessyController.Services.Statistics
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">📊 @(T("Arbitrage: Planned vs Realized"))</RadzenText>
        <InfoTipComponent Text="@HowToRead" />
    </RadzenStack>

    @if (Buckets.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2">@(T("No arbitrage in this period."))</RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">@SummaryText</RadzenText>

        <RadzenChart Style="width: 100%; height: 320px;">
            <RadzenChartTooltipOptions Shared="true" />
            <RadzenLegend Position="LegendPosition.Bottom" />

            <RadzenColumnSeries Data="@Buckets"
                                CategoryProperty="@nameof(ArbitrageBucket.Label)"
                                ValueProperty="@nameof(ArbitrageBucket.PlannedEur)"
                                Title="@T("Planned")"
                                Fill="var(--sessy-planned)" />
            <RadzenColumnSeries Data="@Buckets"
                                CategoryProperty="@nameof(ArbitrageBucket.Label)"
                                ValueProperty="@nameof(ArbitrageBucket.RealizedEur)"
                                Title="@T("Realized")"
                                Fill="var(--sessy-actual)" />

            <RadzenColumnOptions Margin="4" />
            <RadzenCategoryAxis LabelAutoRotation="-45">
                <RadzenAxisTitle Text="@PeriodTitle" />
            </RadzenCategoryAxis>
            <RadzenValueAxis FormatString="€ {0:F2}">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
        </RadzenChart>
    }
</RadzenCard>
