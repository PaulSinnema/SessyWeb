@using SessyController.Services.Items
@using SessyData.Model
@using Radzen
@inherits BaseComponent

<RadzenDataGrid @ref=@financialResultsGrid
                Data=@FinancialResultsList
                Count=@FinancialResultsList!.Count
                Context="data"
                AllowSorting="true"
                AllowFiltering="true"
                AllowPaging="true"
                PagerPosition="PagerPosition.TopAndBottom"
                AllowGrouping="false"
                PageSize="100"
                ShowPagingSummary="true"
                GroupFootersAlwaysVisible="true"
                Render="@OnRender"
                Density="Density.Compact"
                AllGroupsExpanded=@ExpandAllGroups
                PagerHorizontalAlign="HorizontalAlign.Center">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(FinancialResult.YearMonth)" Title="@T("Time")"/>
        <RadzenDataGridColumn Property="@nameof(FinancialResult.Time)" Title="@T("Time")" FormatString="{0:dd-MM-yyyy HH:mm}" FormatProvider="@GetFormatProvider()" />
        <RadzenDataGridColumn Property="@nameof(FinancialResult.Consumed)" Title="@T("Consumed")" />
        <RadzenDataGridColumn Property="@nameof(FinancialResult.Produced)" Title="@T("Produced")" />
        <RadzenDataGridColumn Property="@nameof(FinancialResult.Grid)" Title="@T("Grid")" />
        <RadzenDataGridColumn Property="@nameof(FinancialResult.Price)" Title="@T("Price")" FormatString="{0:C5}" FormatProvider="@GetFormatProvider()" />
        <RadzenDataGridColumn Property="@nameof(FinancialResult.Cost)" Title="@T("Cost")" FormatString="{0:C5}" FormatProvider="@GetFormatProvider()">
            <GroupFooterTemplate>
                <b> @String.Format(GetFormatProvider(), "{0:C5}", GetDailyTotalCost(context.Data!.Items!.Cast<FinancialResult>()))</b>
            </GroupFooterTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>