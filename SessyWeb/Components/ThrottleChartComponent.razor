@using Radzen
@using Radzen.Blazor
@using SessyController.Services
@using SessyController.Services.Items
@inherits BaseComponent

<StatisticsCard Title="@T("🔋 Battery power vs state of charge")" OnRefresh="@RefreshAsync" RefreshTitle="@T("Recompute from the measured models")" Loading="@Loading" IsEmpty="@(_points.Count == 0)">
    <Intro>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">
        @TM("The power the planner assumes per quarter at each state of charge, from the same calculation the plan uses, at the current {0:F0} °C. <b>Charge</b>: {1}. <b>Discharge</b>: {2}. Dashed lines are nameplate.", _temperatureC, _chargeSource, _dischargeSource)
    </RadzenText>

    @if (_chargeHasSlope || _dischargeHasSlope)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">
            🌡️ @TM("Warm batteries cannot shed their heat and deliver less. <b>Charge</b>: {0}. <b>Discharge</b>: {1}. Dotted lines show power at the coolest and warmest measured temperature; outside that range the nearest edge is used, so a dotted line can coincide with the current one.", _chargeTemperatureText, _dischargeTemperatureText)
        </RadzenText>
    }
    </Intro>
    <EmptyContent>@(T("No battery configured."))</EmptyContent>
    <ChildContent>
        <div style="width: 100%; overflow-x: auto;">
            <RadzenChart Style="height: 320px; min-width: 600px; width: 100%;"
                         MarginTop="20" MarginLeft="70" MarginRight="40" MarginBottom="60">
                <RadzenLineSeries Data="@_points"
                                  CategoryProperty="@nameof(PowerPoint.SocPct)"
                                  ValueProperty="@nameof(PowerPoint.ChargeW)"
                                  Title="@T("Charge")"
                                  Stroke="var(--sessy-charge-line)"
                                  StrokeWidth="2">
                    <RadzenMarkers MarkerType="MarkerType.Circle" Size="5" />
                </RadzenLineSeries>
                <RadzenLineSeries Data="@_points"
                                  CategoryProperty="@nameof(PowerPoint.SocPct)"
                                  ValueProperty="@nameof(PowerPoint.DischargeW)"
                                  Title="@T("Discharge")"
                                  Stroke="var(--sessy-discharge-line)"
                                  StrokeWidth="2">
                    <RadzenMarkers MarkerType="MarkerType.Circle" Size="5" />
                </RadzenLineSeries>
                @if (_chargeHasSlope)
                {
                    <RadzenLineSeries Data="@_points"
                                      CategoryProperty="@nameof(PowerPoint.SocPct)"
                                      ValueProperty="@nameof(PowerPoint.ChargeColdW)"
                                      Title="@T("Charge at {0:F0} °C", _chargeColdC)"
                                      Stroke="var(--sessy-charge-line)"
                                      StrokeWidth="1"
                                      LineType="LineType.Dotted" />
                    <RadzenLineSeries Data="@_points"
                                      CategoryProperty="@nameof(PowerPoint.SocPct)"
                                      ValueProperty="@nameof(PowerPoint.ChargeWarmW)"
                                      Title="@T("Charge at {0:F0} °C", _chargeWarmC)"
                                      Stroke="var(--sessy-charge-line)"
                                      StrokeWidth="1"
                                      LineType="LineType.Dotted" />
                }
                @if (_dischargeHasSlope)
                {
                    <RadzenLineSeries Data="@_points"
                                      CategoryProperty="@nameof(PowerPoint.SocPct)"
                                      ValueProperty="@nameof(PowerPoint.DischargeColdW)"
                                      Title="@T("Discharge at {0:F0} °C", _dischargeColdC)"
                                      Stroke="var(--sessy-discharge-line)"
                                      StrokeWidth="1"
                                      LineType="LineType.Dotted" />
                    <RadzenLineSeries Data="@_points"
                                      CategoryProperty="@nameof(PowerPoint.SocPct)"
                                      ValueProperty="@nameof(PowerPoint.DischargeWarmW)"
                                      Title="@T("Discharge at {0:F0} °C", _dischargeWarmC)"
                                      Stroke="var(--sessy-discharge-line)"
                                      StrokeWidth="1"
                                      LineType="LineType.Dotted" />
                }
                <RadzenLineSeries Data="@_points"
                                  CategoryProperty="@nameof(PowerPoint.SocPct)"
                                  ValueProperty="@nameof(PowerPoint.ChargeNameplateW)"
                                  Title="@T("Charge nameplate")"
                                  Stroke="var(--sessy-charge-line)"
                                  StrokeWidth="1"
                                  LineType="LineType.Dashed" />
                <RadzenLineSeries Data="@_points"
                                  CategoryProperty="@nameof(PowerPoint.SocPct)"
                                  ValueProperty="@nameof(PowerPoint.DischargeNameplateW)"
                                  Title="@T("Discharge nameplate")"
                                  Stroke="var(--sessy-discharge-line)"
                                  StrokeWidth="1"
                                  LineType="LineType.Dashed" />
                <RadzenCategoryAxis FormatString="{0}%">
                    <RadzenAxisTitle Text="@T("State of charge")" />
                </RadzenCategoryAxis>
                <RadzenValueAxis Min="0" FormatString="{0:F0} W">
                    <RadzenGridLines Visible="true" />
                    <RadzenAxisTitle Text="@T("Power")" />
                </RadzenValueAxis>
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        </div>
    </ChildContent>
</StatisticsCard>
