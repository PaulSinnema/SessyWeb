@using SessyController.Services.Statistics
@using SessyWeb.Components
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
        <RadzenText TextStyle="TextStyle.H6">📈 @T("Return on Investment")</RadzenText>
        @if (Dashboard!.Investment.UsesProjection)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Warning"
                         Text="@T("Projection from {0:dd-MM-yyyy}", Dashboard.Investment.DataAvailableFrom)"
                         title="@T("Insufficient historical data — savings before this date are extrapolated using seasonal monthly averages.")" />
        }
    </RadzenStack>
    <RadzenRow>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Total investment")" Value="@($"€ {Dashboard!.Investment.TotalNetInvestmentEur:F2}")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Realized savings")" Value="@($"€ {Dashboard!.Investment.TotalRealizedSavingsEur:F2}")" />
        </RadzenColumn>
        @if (Dashboard!.Investment.UsesProjection)
        {
            <RadzenColumn Size="6" SizeMD="3">
                <StatCardComponent Title="@T("Projected total savings")" Value="@($"€ {Dashboard!.Investment.ProjectedTotalSavingsEur:F2}")" Highlight="true" />
            </RadzenColumn>
        }
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Remaining to recover")" Value="@($"€ {Dashboard!.Investment.RemainingInvestmentEur:F2}")" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Recovered")" Value="@($"{Dashboard.Investment.RecoveredPct:F1} %")" Highlight="true" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Projected annual savings")" Value="@T("€ {0:F2}/year", Dashboard.Investment.ProjectedAnnualSavingsEur)" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Payback period")" Value="@(Dashboard.Investment.ProjectedPaybackYears >= 999 ? "—" : T("{0:F1} years", Dashboard.Investment.ProjectedPaybackYears))" />
        </RadzenColumn>
        <RadzenColumn Size="6" SizeMD="3">
            <StatCardComponent Title="@T("Break-even date")"
                               Value="@(Dashboard.Investment.ProjectedBreakEvenDate.HasValue ? Dashboard.Investment.ProjectedBreakEvenDate.Value.ToString("dd-MM-yyyy") : T("Unknown"))"
                               Highlight="true" />
        </RadzenColumn>
    </RadzenRow>

    @if (BatteryLives.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-4">@T("Battery life") <InfoTipComponent Text="@BatteryLifeInfo" /></RadzenText>

        <RadzenChart Style="@BatteryLifeChartStyle">
            <RadzenChartTooltipOptions Shared="true" />
            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

            <RadzenStackedBarSeries Data="@BatteryLives"
                                    Title="@T("Used")"
                                    CategoryProperty="@nameof(BatteryLife.Label)"
                                    ValueProperty="@nameof(BatteryLife.UsedYears)"
                                    Fill="var(--sessy-actual)"
                                    Stroke="var(--sessy-actual)" />
            <RadzenStackedBarSeries Data="@BatteryLives"
                                    Title="@T("Remaining")"
                                    CategoryProperty="@nameof(BatteryLife.Label)"
                                    ValueProperty="@nameof(BatteryLife.RemainingYears)"
                                    Fill="var(--sessy-planned)"
                                    Stroke="var(--sessy-planned)" />

            <RadzenCategoryAxis />
            <RadzenValueAxis Min="0" FormatString="{0:0}">
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="@T("Years since purchase")" />
            </RadzenValueAxis>
        </RadzenChart>
    }

    @if (Dashboard!.Investment.ComponentBreakdown.Any())
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-4">@T("Per component")</RadzenText>
        <RadzenDataGrid Data="@Dashboard.Investment.ComponentBreakdown"
                        TItem="InvestmentCategoryStats"
                        Density="Density.Compact"
                        AllowSorting="false"
                        AllowFiltering="false"
                        AllowPaging="false">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.Category)" Title="@T("Component")" />
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.InstallationDate)" Title="@T("Since")" FormatString="{0:dd-MM-yyyy}" />
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.NetAmountEur)" Title="@T("Net (€)")" FormatString="{0:F2}" />
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.AnnualSavingsEur)" Title="@T("Savings (€/yr)")" FormatString="{0:F2}" />
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.ProjectedTotalSavingsEur)" Title="@T("Total saved (€)")" FormatString="{0:F2}" />
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.RecoveredPct)" Title="@T("Recovered (%)")" FormatString="{0:F1}" />
                <RadzenDataGridColumn TItem="InvestmentCategoryStats" Title="@T("Payback (yr)")">
                    <Template Context="cat">
                        @(cat.PaybackYears >= 999 ? "—" : $"{cat.PaybackYears:F1}")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InvestmentCategoryStats" Title="@T("Break-even")">
                    <Template Context="cat">
                        @(cat.BreakEvenDate.HasValue ? cat.BreakEvenDate.Value.ToString("dd-MM-yyyy") : "—")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InvestmentCategoryStats" Title="@T("Battery cycles")">
                    <Template Context="cat">
                        @(CyclesOf(cat) is double cycles ? $"{cycles:F0}" : "—")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InvestmentCategoryStats" Title="@T("Expected end of life")">
                    <Template Context="cat">
                        @EndOfLifeText(cat)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(InvestmentCategoryStats.SavingsSource)" Title="@T("Savings basis")" />
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

