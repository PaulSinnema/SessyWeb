@using SessyController.Services
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
        <RadzenText TextStyle="TextStyle.H6">💶 Financial forecast for next year</RadzenText>
        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@LoadAsync" title="Reload (the planner replay runs once a day)" />
    </RadzenStack>

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="rz-mt-2" />
    }
    else if (_lastYear == null || _sameUsage == null)
    {
        <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-2">
            Not enough data: needs meter readings for the last 12 months and a Taxes row valid next year.
        </RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">
            All amounts incl. VAT, at the market prices of the last 12 full months and the tariffs from the Taxes page.
            <b>Last 12 months</b>: measured grid import and export at the tariffs that applied.
            <b>Same usage</b>: those flows at the tariffs valid on 1 January @_sameUsage.From.Year
            (netting @(_sameUsage.Netting ? "on" : "off")) — an upper bound, because the planner adapts.
            <b>Planner replay</b>: the planner replans that year day by day with next year's tariffs, from the
            measured house load and solar; this is what to expect. It runs once a day in the background
            (a few minutes); the difference column uses it when available.
        </RadzenText>

        <div style="width: 100%; overflow-x: auto;" class="rz-mt-2">
            <table class="rz-grid-table rz-grid-table-fixed" style="width: 100%; min-width: 640px;">
                <thead>
                    <tr>
                        <th style="text-align: left;"></th>
                        <th style="text-align: right;">@_lastYear.Label</th>
                        <th style="text-align: right;">@_sameUsage.Label</th>
                        <th style="text-align: right;">@ReplayHeader</th>
                        <th style="text-align: right;">Difference</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _lines)
                    {
                        <tr style="@(line.Bold ? "font-weight: bold;" : "")">
                            <td>@line.Label</td>
                            <td style="text-align: right;">@Format(line.LastYear, line.IsEuro)</td>
                            <td style="text-align: right;">@Format(line.SameUsage, line.IsEuro)</td>
                            <td style="text-align: right;">@Format(line.Replay, line.IsEuro)</td>
                            <td style="text-align: right;">@FormatDifference(line)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</RadzenCard>
