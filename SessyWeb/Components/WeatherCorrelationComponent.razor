@using SessyController.Services.Statistics
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<StatisticsCard Title="@T("🌦️ Consumption and weather")" Info="@HowToRead" OnRefresh="@LoadAsync" Loading="@Loading" IsEmpty="@(_dayCount < 3)">
    <EmptyContent>@(T("Not enough data: needs at least a few complete days in the Consumption table."))</EmptyContent>
    <ChildContent>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">
            @T("One dot per complete day ({0} days, {1:dd-MM-yyyy} to {2:dd-MM-yyyy}): the day's house consumption against its average weather, coloured per season. The line is the least-squares fit over all days. The three are linked — sunny days tend to be warmer, damp days colder — so a correlation with radiation or humidity can partly be the temperature effect.", _dayCount, _firstDay, _lastDay)
        </RadzenText>

        <RadzenRow Gap="2rem" class="rz-mt-2">
            @foreach (var panel in _panels)
            {
                <RadzenColumn Size="12">
                    <RadzenText TextStyle="TextStyle.Subtitle1">@panel.Title <InfoTipComponent Text="@panel.Info" /></RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">@FitText(panel)</RadzenText>

                    <RadzenChart Style="width: 100%; height: 55vh; min-height: 420px;">
                        <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                        @foreach (var season in panel.Seasons)
                        {
                            <RadzenLineSeries Data="@season.Points"
                                              Title="@T(season.Season.ToString())"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Stroke="@season.Color"
                                              StrokeWidth="0">
                                <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Size="5"
                                               Fill="@season.Color" Stroke="@season.Color" />
                            </RadzenLineSeries>
                        }

                        @if (panel.Trend.Count == 2)
                        {
                            <RadzenLineSeries Data="@panel.Trend"
                                              Title="@T("Fit")"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Stroke="var(--rz-text-color)"
                                              StrokeWidth="2"
                                              LineType="LineType.Dashed" />
                        }

                        <RadzenCategoryAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="@panel.Unit" />
                        </RadzenCategoryAxis>
                        <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="@T("kWh / day")" />
                        </RadzenValueAxis>
                    </RadzenChart>
                </RadzenColumn>
            }
        </RadzenRow>
    </ChildContent>
</StatisticsCard>
