@using SessyController.Services.Statistics
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px">
        <RadzenText TextStyle="TextStyle.H6">🌦️ Consumption and weather <InfoTipComponent Text="@HowToRead" /></RadzenText>
        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@LoadAsync" title="Reload" />
    </RadzenStack>

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="rz-mt-2" />
    }
    else if (_dayCount < 3)
    {
        <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-2">
            Not enough data: needs at least a few complete days in the Consumption table.
        </RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">
            One dot per complete day (@_dayCount days, @_firstDay?.ToString("dd-MM-yyyy") to @_lastDay?.ToString("dd-MM-yyyy")):
            the day's house consumption against its average weather, coloured per season. The line is the
            least-squares fit over all days. The three are linked — sunny days tend to be warmer, damp days
            colder — so a correlation with radiation or humidity can partly be the temperature effect.
        </RadzenText>

        <RadzenRow Gap="2rem" class="rz-mt-2">
            @foreach (var panel in _panels)
            {
                <RadzenColumn Size="12">
                    <RadzenText TextStyle="TextStyle.Subtitle1">@panel.Title <InfoTipComponent Text="@panel.Info" /></RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">@FitText(panel)</RadzenText>

                    <RadzenChart Style="width: 100%; height: 55vh; min-height: 420px;">
                        <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

                        @foreach (var season in panel.Seasons)
                        {
                            <RadzenLineSeries Data="@season.Points"
                                              Title="@season.Season.ToString()"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Stroke="@season.Color"
                                              StrokeWidth="0">
                                <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Size="5"
                                               Fill="@season.Color" Stroke="@season.Color" />
                            </RadzenLineSeries>
                        }

                        @if (panel.Trend.Count == 2)
                        {
                            <RadzenLineSeries Data="@panel.Trend"
                                              Title="Fit"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Stroke="var(--rz-text-color)"
                                              StrokeWidth="2"
                                              LineType="LineType.Dashed" />
                        }

                        <RadzenCategoryAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="@panel.Unit" />
                        </RadzenCategoryAxis>
                        <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="kWh / day" />
                        </RadzenValueAxis>
                    </RadzenChart>
                </RadzenColumn>
            }
        </RadzenRow>
    }
</RadzenCard>
