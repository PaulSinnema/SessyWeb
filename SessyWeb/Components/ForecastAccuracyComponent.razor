@using SessyController.Services.Statistics
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<StatisticsCard Title="@T("🎯 Consumption forecast: planner vs. model")" Info="@HowToRead" OnRefresh="@LoadAsync" Loading="@Loading" IsEmpty="@(_result == null || _result.Days.Count == 0)">
    <EmptyContent>@T("Not enough data yet: needs complete days for which the planner stored a forecast {0} hours ahead.", SessyController.Services.Statistics.ForecastAccuracyService.DefaultLeadHours)</EmptyContent>
    <ChildContent>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">@SummaryText()</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption">@ErrorText(T("Planner"), _result!.Planner)</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption">@ErrorText(T("Model"), _result!.Model)</RadzenText>

        <RadzenChart Style="width: 100%; height: 45vh; min-height: 360px;">
            <RadzenChartTooltipOptions Shared="true" />
            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

            <RadzenColumnSeries Data="@_result!.Days"
                                Title="@T("Measured")"
                                CategoryProperty="Label"
                                ValueProperty="MeasuredKWh"
                                Fill="var(--sessy-consumption-area)"
                                Stroke="var(--sessy-consumption-line)"
                                StrokeWidth="2" />

            <RadzenLineSeries Data="@_result.Days"
                              Title="@T("Planner (a day ahead)")"
                              CategoryProperty="Label"
                              ValueProperty="PlannerKWh"
                              Stroke="var(--sessy-year-1-line)"
                              StrokeWidth="2" />

            @if (_result.Model != null)
            {
                <RadzenLineSeries Data="@_result.Days"
                                  Title="@T("Model (actual temperature)")"
                                  CategoryProperty="Label"
                                  ValueProperty="ModelKWh"
                                  Stroke="var(--sessy-temperature-line)"
                                  StrokeWidth="2" />
            }

            <RadzenCategoryAxis LabelAutoRotation="-45">
                <RadzenAxisTitle Text="@T("Day")" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="@T("kWh / day")" />
            </RadzenValueAxis>
        </RadzenChart>
    </ChildContent>
</StatisticsCard>
