@using SessyController.Services.Statistics
@using SessyWeb.Components
@using Radzen
@using Radzen.Blazor

<RadzenCard Style="height: 100%;">
    <RadzenText TextStyle="TextStyle.H6">⚡ Energy Flows</RadzenText>

    @* The window these figures cover is not always the period that was picked: Statistics from
       date cuts off everything before it, and an incomplete first or last day is dropped so the
       daily averages are not distorted. Saying so is the point — a total covering five of the
       eight months you asked for looks like an error in the total. *@
    <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.75;">
        @($"{Dashboard!.EffectiveStart:dd-MM-yyyy} — {Dashboard!.EffectiveEnd:dd-MM-yyyy}")
        @if (Dashboard!.ClampedByStatisticsFromDate)
        {
            <span> · starts at the configured "Statistics from date"</span>
        }
    </RadzenText>

    <RadzenRow>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Total consumption" Value="@($"{Dashboard!.TotalConsumptionKWh:F1} kWh")" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Grid import" Value="@($"{Dashboard!.TotalGridImportKWh:F1} kWh")" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Grid export" Value="@($"{Dashboard!.TotalGridExportKWh:F1} kWh")" />
        </RadzenColumn>
        @* Own production versus consumption — meaningless without an inverter, where every kWh
           comes from the grid whether the battery is in between or not. *@
        @if (Dashboard!.SolarIsConfigured)
        {
            <RadzenColumn Size="6">
                <StatCardComponent Title="Self sufficiency" Value="@($"{Dashboard!.SelfSufficiencyPct:F1} %")" />
            </RadzenColumn>
        }
    </RadzenRow>
    <RadzenText TextStyle="TextStyle.H6" Style="margin-top: 12px;">🏠 Consumption</RadzenText>
    <RadzenRow>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Avg daily" Value="@($"{Dashboard!.AvgDailyConsumptionKWh:F1} kWh/day")" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Peak daily" Value="@($"{Dashboard!.PeakDailyConsumptionKWh:F1} kWh")" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Weekday" Value="@($"{Dashboard!.WeekdayConsumptionKWh:F1} kWh")" />
        </RadzenColumn>
        <RadzenColumn Size="6">
            <StatCardComponent Title="Weekend" Value="@($"{Dashboard!.WeekendConsumptionKWh:F1} kWh")" />
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public DashboardStatistics? Dashboard { get; set; }
}
