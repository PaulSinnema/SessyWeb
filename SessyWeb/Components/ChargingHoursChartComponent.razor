﻿@using SessyWeb.Helpers
@using SessyWeb.Pages
@using System.Globalization

@inherits BaseComponent

<style>
    /* Hide the "now" vertical line from the legend (always the last series). */
    .now-chart .rz-legend-item:last-child {
        display: none;
    }
</style>

@* Says whose plan is on screen. Without it the chart looks the same whether the bars are ours or
   Charged's, which is exactly the confusion this is meant to remove. The dashed line is always the
   plan that is NOT being executed. *@
<div style="padding: 2px 8px; font-size: 0.85em; color: var(--rz-text-secondary-color);">
    @if (ChargedInControl)
    {
        <text><b>Charged</b> is in control — the areas are the batteries' own schedule, the dashed line is SessyWeb's plan.</text>
    }
    else
    {
        <text><b>SessyWeb</b> is in control — the areas are our plan, the dashed line is what Charged would have done.</text>
    }

    @if (ChargedScheduleFetchedAt != null)
    {
        <text> Charged's schedule read at @ChargedScheduleFetchedAt.Value.ToString("HH:mm").</text>
    }
    else
    {
        <text> No schedule received from the batteries yet.</text>
    }
</div>

<div class="now-chart" style="width: 100%; overflow: auto;">
    <RadzenChart Style=@GraphStyle @ref=@QuarterlyHourChart AllowSeriesHover="false">
        <RadzenLegend Position="@((ScreenInfo?.IsMobile ?? false) ? LegendPosition.Right : LegendPosition.Top)" Visible="true" />
        <RadzenChartTooltipOptions Shared="false" Visible="true" />

        <RadzenColumnSeries Data="@QuarterlyInfos"
                            CategoryProperty="Time"
                            Title="Buying price (€/kWh)"
                            Fill="#324ab2"
                            Stroke="#324ab2"
                            ValueProperty="BuyingPrice">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="true" Appearance="DataLabelAppearance.Plain" />
                @if (IsExpected(QuarterlyInfos))
                {
                    <RadzenSeriesAnnotation Data="@QuarterlyInfos.First(q => q.IsPriceExpected)"
                                            Text="↑ Prices are predicted, plan will be calculated after EPEX prices arrive →"
                                            OffsetX="220"
                                            OffsetY="300"
                                            Fill="orange" />
                }
                @if (ShowAll && NowQuarter != null)
                {
                    <RadzenSeriesAnnotation Data="@NowQuarter"
                                            Text="← now"
                                            OffsetX="50"
                                            OffsetY="-150"
                                            Fill="white" />
                }
            </ChildContent>
        </RadzenColumnSeries>

        <RadzenColumnSeries Data="@QuarterlyInfos"
                            CategoryProperty="Time"
                            Title="Selling price (€/kWh)"
                            Fill="#00aae4"
                            Stroke="#00aae4"
                            LineType="LineType.Dashed"
                            ValueProperty="SellingPrice">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="@ShowSellingPriceLabels" Appearance="DataLabelAppearance.Plain" />
            </ChildContent>
        </RadzenColumnSeries>

        <RadzenColumnSeries Data="@QuarterlyInfos"
                            CategoryProperty="Time"
                            Title="Cost basis delivered (€/kWh)"
                            Fill="#9b59b6"
                            Stroke="#9b59b6"
                            ValueProperty="ProjectedCostBasisDeliveredEur">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
            </ChildContent>
        </RadzenColumnSeries>

        <RadzenColumnSeries Visible="@WeAreInControl"
                            Data="@QuarterlyInfos"
                            Stroke="green"
                            Fill="orange"
                            Title="Revenue (€/quarter)"
                            CategoryProperty="Time"
                            ValueProperty="Profit">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>

            <ChildContent>
                @{
                    if (QuarterlyInfos != null)
                    {
                        foreach (var item in QuarterlyInfos.Where(qi => qi.Profit != 0.0))
                        {
                            <RadzenSeriesAnnotation Visible="true"
                                                    TItem="QuarterlyInfoView"
                                                    Data="@item"
                                                    OffsetX="12"
                                                    OffsetY="@(item.Profit > 0.00 ? -16 : 16)"
                                                    Text="@(String.Format(CultureInfo.CurrentCulture, "{0:0.00}", item.Profit))"
                                                    Fill="orange" />
                        }
                    }
                }
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenColumnSeries>

        <RadzenAreaSeries Visible="@WeAreInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(255, 215, 0, 0.5)"
                          Stroke="#ffd700"
                          Title="Zero net home"
                          ValueProperty="ZeroNetHomeVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        <RadzenAreaSeries Visible="@WeAreInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(255, 0, 0, 0.45)"
                          Stroke="red"
                          StrokeWidth="1.5"
                          Title="Throttle loss charge (kW)"
                          ValueProperty="UnthrottledChargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        <RadzenAreaSeries Visible="@WeAreInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(255, 0, 0, 0.45)"
                          Stroke="red"
                          StrokeWidth="1.5"
                          Title="Throttle loss discharge (kW)"
                          ValueProperty="UnthrottledDischargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        @* Our own plan as filled areas — only while SessyWeb is the one executing it. Under
           Charged the same numbers come back below as a dashed shadow line. *@
        <RadzenAreaSeries Visible="@(!ChargedInControl)"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(255, 102, 0, 0.5)"
                          Stroke="#ff6600"
                          Title="Planned charge (kW)"
                          ValueProperty="PlannedChargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        <RadzenAreaSeries Visible="@(!ChargedInControl)"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(0, 204, 68, 0.5)"
                          Stroke="#00cc44"
                          Title="Planned discharge (kW)"
                          ValueProperty="PlannedDischargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        @* Charged's own schedule. Same colours as the plan areas above so charging still reads as
           orange below zero and discharging as green above it. *@
        <RadzenAreaSeries Visible="@ChargedInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(255, 102, 0, 0.5)"
                          Stroke="#ff6600"
                          Title="Charged charge (kW)"
                          ValueProperty="ChargedChargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        <RadzenAreaSeries Visible="@ChargedInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(0, 204, 68, 0.5)"
                          Stroke="#00cc44"
                          Title="Charged discharge (kW)"
                          ValueProperty="ChargedDischargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        @* The mirror image: while SessyWeb executes, Charged's own schedule is the road not taken.
           Same dashed treatment, so whichever plan is not being executed reads as a shadow. *@
        <RadzenLineSeries Visible="@(!ChargedInControl)"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#ff6600"
                          StrokeWidth="1"
                          LineType="LineType.Dashed"
                          Title="Charged plan charge (kW)"
                          ValueProperty="ChargedChargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Visible="@(!ChargedInControl)"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#00cc44"
                          StrokeWidth="1"
                          LineType="LineType.Dashed"
                          Title="Charged plan discharge (kW)"
                          ValueProperty="ChargedDischargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        @* What SessyWeb would have done instead — the price of handing over control, in one line. *@
        <RadzenLineSeries Visible="@ChargedInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#ff6600"
                          StrokeWidth="1"
                          LineType="LineType.Dashed"
                          Title="SessyWeb plan charge (kW)"
                          ValueProperty="PlannedChargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Visible="@ChargedInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#00cc44"
                          StrokeWidth="1"
                          LineType="LineType.Dashed"
                          Title="SessyWeb plan discharge (kW)"
                          ValueProperty="PlannedDischargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        @* Actual battery power, in the same colours as the planned areas. Bound to
           ActualPowerPoints (only quarters with a real reading), so these end at "now" instead
           of tracing the plan a second time across the future. *@
        <RadzenAreaSeries Data="@ActualPowerPoints"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(255, 102, 0, 0.5)"
                          Stroke="#ff6600"
                          Title="Charge power actual (kW)"
                          ValueProperty="ChargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                @* Marker needed because without "Show all" only the executing quarter has a
                   real reading — a one-point area renders as nothing. *@
                <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Size="4" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        <RadzenAreaSeries Data="@ActualPowerPoints"
                          Smooth="true"
                          CategoryProperty="Time"
                          Fill="rgba(0, 204, 68, 0.5)"
                          Stroke="#00cc44"
                          Title="Discharge power actual (kW)"
                          ValueProperty="DischargePowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Size="4" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenAreaSeries>

        <RadzenLineSeries Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#324ab2"
                          Title="Smoothed buying price (€/kWh)"
                          LineType="LineType.Solid"
                          ValueProperty="SmoothedBuyingPrice">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#00aae4"
                          Title="Smoothed selling price (€/kWh)"
                          LineType="LineType.Solid"
                          ValueProperty="SmoothedSellingPrice">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        @* SOC. Under Charged this follows their schedule instead of our plan simulation, which
           would otherwise draw a curve for something that is not going to happen. *@
        <RadzenLineSeries Visible="@(!ChargedInControl)"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="red"
                          Title="Charge remaining (kWh)"
                          ValueProperty="ChargeLeftVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Visible="@ChargedInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="red"
                          Title="Charge remaining, Charged (kWh)"
                          ValueProperty="ChargedChargeLeftVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="gold"
                          Title="Solar power (kWh/quarter)"
                          LineType="LineType.Solid"
                          ValueProperty="SmoothedSolarPowerVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Visible="@WeAreInControl"
                          Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#b06500"
                          Title="Charge needed (kWh)"
                          LineType="LineType.Solid"
                          ValueProperty="ChargeNeededVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Title="Est. consumption (W)"
                          LineType="LineType.Solid"
                          ValueProperty="SmoothedConsumptionVisual">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Data="@QuarterlyInfos"
                          Smooth="true"
                          CategoryProperty="Time"
                          Title="Delta lowest price (€/kWh)"
                          LineType="LineType.Solid"
                          ValueProperty="DeltaLowestPrice">
            <TooltipTemplate Context="data">
                <ChargingHoursTooltip QuarterlyInfo=@data />
            </TooltipTemplate>
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        <RadzenLineSeries Visible="@ShowPlanHistory"
                          Data="@PlanPoints"
                          Smooth="true"
                          CategoryProperty="Time"
                          Stroke="#ff33cc"
                          StrokeWidth="3.5"
                          LineType="LineType.Solid"
                          Title="Plan history (kW)"
                          ValueProperty="PlanPowerVisual">
            <ChildContent>
                <RadzenMarkers Visible="false" />
                <RadzenSeriesDataLabels Visible="false" />
            </ChildContent>
        </RadzenLineSeries>

        @* Vertical "now" line — single full-height bar at the current quarter. *@
        @if (ShowAll && NowQuarter != null)
        {
            <RadzenColumnSeries Data="@(new[] { NowQuarter })"
                                CategoryProperty="Time"
                                ValueProperty="NowLineHeight"
                                Fill="rgba(255,255,255,0.3)"
                                Stroke="white"
                                StrokeWidth="1">
                <ChildContent>
                    <RadzenSeriesDataLabels Visible="false" />
                </ChildContent>
            </RadzenColumnSeries>
        }

        <RadzenCategoryAxis Padding="40" Formatter="@Formatters.FormatAsDayHour" TickDistance="152">
            <RadzenGridLines Visible="true" />
            <RadzenAxisTitle Text="Time" />
        </RadzenCategoryAxis>

        <RadzenValueAxis Formatter="@Formatters.FormatAsPrice" Min="@ChartMin" Max="@ChartMax" Step="0.10">
            <RadzenGridLines Visible="true" />
            <RadzenAxisTitle Text="Price" />
        </RadzenValueAxis>

        <RadzenBarOptions Radius="5" />
    </RadzenChart>
</div>