@using Radzen
@using Radzen.Blazor
@using SessyController.Services
@inherits BaseComponent

@* Renders one FIFO stack (oldest first). Shared by the measured and the projected block. *@

<RadzenDataGrid Data="@Layers" TItem="ChargeCostBasisService.CostBasisLayerInfo"
                AllowSorting="false" Density="Density.Compact" class="rz-mt-2">
    <Columns>
        <RadzenDataGridColumn TItem="ChargeCostBasisService.CostBasisLayerInfo" Title="#" Width="50px">
            <Template Context="layer">
                @(layer.Index + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ChargeCostBasisService.CostBasisLayerInfo" Title="@T("Energy")">
            <Template Context="layer">@($"{layer.Wh / 1000.0:F3} kWh")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ChargeCostBasisService.CostBasisLayerInfo" Title="@T("Cost / kWh stored")">
            <Template Context="layer">@($"€ {layer.CostEurPerKWh:F4}")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ChargeCostBasisService.CostBasisLayerInfo" Title="@T("Cost / kWh delivered")">
            <Template Context="layer">@($"€ {layer.CostEurPerKWhDelivered:F4}")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ChargeCostBasisService.CostBasisLayerInfo" Title="@T("Source")">
            <Template Context="layer">
                @if (layer.IsSolar)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@T("Solar")" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@T("Grid")" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ChargeCostBasisService.CostBasisLayerInfo> Layers { get; set; } = [];
}
