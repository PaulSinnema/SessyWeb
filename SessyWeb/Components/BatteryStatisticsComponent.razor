@using SessyController.Services.Statistics
@using Radzen
@using Radzen.Blazor
@inherits BaseComponent

<StatisticsCard Title="🔋 Battery use and efficiency" Info="@HowToRead" OnRefresh="@RefreshAsync" Loading="@Loading" IsEmpty="@(_result == null || _result.Months.Count == 0)">
    <EmptyContent>Not enough data yet: no battery measurements stored.</EmptyContent>
    <ChildContent>
        @if (_cycles != null && _cycles.Total.Months.Count > 0)
        {
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">Lifetime forecast <InfoTipComponent Text="@ForecastInfo" /></RadzenText>

            <RadzenDataGrid Data="@Lifetimes" TItem="CycleLifetime" AllowSorting="false" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="CycleLifetime" Property="@nameof(CycleLifetime.Name)" Title="Battery" />
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="Cycles used" TextAlign="TextAlign.Right">
                        <Template Context="l">@UsedText(l)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="Pace / year" TextAlign="TextAlign.Right">
                        <Template Context="l">@PaceText(l)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="Cycles used up" TextAlign="TextAlign.Right">
                        <Template Context="l">@DateText(l.CyclesEnd)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="Rated age reached" TextAlign="TextAlign.Right">
                        <Template Context="l">@DateText(l.CalendarEnd)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="Capacity" TextAlign="TextAlign.Right">
                        <Template Context="l">@CapacityText(l)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="@CapacityEndTitle" TextAlign="TextAlign.Right">
                        <Template Context="l">@DateText(l.CapacityEnd)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CycleLifetime" Title="Expected end of life" TextAlign="TextAlign.Right">
                        <Template Context="l"><strong>@EndText(l)</strong></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3">@CyclesText()</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption">@LifetimeText()</RadzenText>

        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-3">Energy and round-trip efficiency per month <InfoTipComponent Text="@EnergyInfo" /></RadzenText>

        <RadzenChart Style="width: 100%; height: 45vh; min-height: 360px;">
            <RadzenChartTooltipOptions Shared="true" />
            <RadzenLegend Position="LegendPosition.Bottom" Visible="true" />

            <RadzenColumnSeries Data="@_result!.Months"
                                Title="Charged"
                                CategoryProperty="Label"
                                ValueProperty="ChargedKWh"
                                Fill="var(--sessy-charge-area)"
                                Stroke="var(--sessy-charge-line)"
                                StrokeWidth="2" />

            <RadzenColumnSeries Data="@_result.Months"
                                Title="Discharged"
                                CategoryProperty="Label"
                                ValueProperty="DischargedKWh"
                                Fill="var(--sessy-discharge-area)"
                                Stroke="var(--sessy-discharge-line)"
                                StrokeWidth="2" />

            <RadzenLineSeries Data="@EfficiencyMonths"
                              Title="Round-trip efficiency"
                              CategoryProperty="Label"
                              ValueProperty="RoundTripPercent"
                              ValueAxisName="efficiency"
                              Stroke="var(--sessy-temperature-line)"
                              StrokeWidth="2" />

            <RadzenCategoryAxis LabelAutoRotation="-45">
                <RadzenAxisTitle Text="Month" />
            </RadzenCategoryAxis>
            <RadzenValueAxis Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="kWh" />
            </RadzenValueAxis>
            <RadzenValueAxis Name="efficiency" Width="100" Min="@(50.0)" Max="@(100.0)" Formatter="@Helpers.Formatters.FormatAsRoundedNumberWithZeroSuppression">
                <RadzenAxisTitle Text="%" />
            </RadzenValueAxis>
        </RadzenChart>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" class="rz-mt-3">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">Full cycles <InfoTipComponent Text="@CyclesInfo" /></RadzenText>
            @if (_cycles != null)
            {
                <RadzenSwitch @bind-Value="_withEstimate" Name="withEstimate" />
                <RadzenLabel Text="Include estimate" Component="withEstimate" />
            }
        </RadzenStack>

        @if (_cycles != null && _cycles.Total.Months.Count > 0)
        {
            <RadzenTabs class="rz-mt-3">
                <Tabs>
                    @foreach (var series in AllSeries)
                    {
                        <RadzenTabsItem Text="@series.Name">
                            <RadzenText TextStyle="TextStyle.Caption">@SeriesText(series)</RadzenText>
                            <CycleChartComponent Series="@series" WithEstimate="@_withEstimate" />

                            @if (series.Health is CapacityHealth health && health.Months.Count > 0)
                            {
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-3">Measured capacity per month <InfoTipComponent Text="@CapacityInfo" /></RadzenText>

                                <RadzenChart Style="width: 100%; height: 260px;">
                                    <RadzenChartTooltipOptions Shared="true" />
                                    <RadzenLegend Visible="false" />
                                    <RadzenLineSeries Data="@health.Months"
                                                      Title="Usable capacity"
                                                      CategoryProperty="@nameof(CapacityMonth.Label)"
                                                      ValueProperty="@nameof(CapacityMonth.CapacityKWh)"
                                                      Stroke="var(--sessy-discharge-line)"
                                                      StrokeWidth="2">
                                        <RadzenMarkers MarkerType="MarkerType.Circle" />
                                    </RadzenLineSeries>
                                    <RadzenCategoryAxis LabelAutoRotation="-45" />
                                    <RadzenValueAxis Min="0" FormatString="{0:0.0}">
                                        <RadzenGridLines Visible="true" />
                                        <RadzenAxisTitle Text="kWh" />
                                    </RadzenValueAxis>
                                </RadzenChart>
                            }
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        }
    </ChildContent>
</StatisticsCard>
