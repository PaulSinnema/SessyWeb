@inherits LayoutComponentBase
@implements IDisposable
@inject CookieThemeService CookieThemeService
@inject ThemeService ThemeService
@inject RadzenTheme RadzenTheme
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment HostEnvironment
@inject SystemCapabilitiesService Capabilities
@inject SettingsService SettingsService

@{
    // Bump the version in SessyCommon/AppInfo.cs — Program.cs writes that same value into the
    // AppVersions table, so the database records which build it belongs to.
    string Version = SessyCommon.AppInfo.Version;
}

<AntiforgeryToken />

<CascadingValue Value=@ScreenInfo Name="ScreenInfo" IsFixed=false>
    <CascadingValue Value="(Action<bool>)SetIsBusy">
        @{
            var show = ((ScreenInfo.IsMobile && ScreenInfo.IsLandscape) || !ScreenInfo.IsMobile);
        }

        <RadzenTooltip />
        <RadzenChartTooltip />
        <RadzenTheme Theme="@NewTheme" />

        <BusyOverlay @ref="_busyOverlay" />

        @{
            var isMobile = ScreenInfo.IsMobile;
        }

        <RadzenLayout Style="height: 100vh;">
            <RadzenHeader>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0"
                             class="header-stack">

                    <RadzenSidebarToggle Click="@ToggleDisplayStyle" />

                    <a href="https://sessy.nl" target="_blank" Style="background-color: beige; max-width: 120px; flex-shrink: 0;">
                        <RadzenImage Path="/Images/sessy.svg" Style="padding: 5px;" />
                    </a>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="header-theme">
                        @if (!isMobile)
                        {
                            <RadzenLabel Text="Theme:" Style="margin-right: 10px;" />
                        }
                        <RadzenDropDown Style="@(isMobile ? "width: 110px;" : "width: 200px;")"
                                        Name="ThemeDropDown"
                                        TValue="string"
                                        Value="@ThemeService.Theme"
                                        ValueChanged="@ChangeTheme"
                                        Data="@Themes.Free"
                                        TextProperty=@nameof(Theme.Text)
                                        ValueProperty=@nameof(Theme.Value) />
                        @if (HostEnvironment.IsDevelopment())
                        {
                            <RadzenBadge Text="TEST" BadgeStyle="BadgeStyle.Warning" Style="margin-left: 10px; font-weight: bold;" />
                        }
                        @if (!isMobile)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin-left: 10px; color:var(--rz-text-secondary-color)">@Version</RadzenText>
                        }
                    </RadzenStack>

                    @if (show)
                    {
                        <Clock />
                    }
                </RadzenStack>
            </RadzenHeader>

            <RadzenPanelMenu DisplayStyle="@DisplayStyle" Style="@MenuStyle">
                <RadzenPanelMenuItem Text="Charging hours"
                                     Path="charginghours"
                                     Click="@CollapseMenu"
                                     Icon="bolt" />
                @* No inverter configured means no measurements to show — see SystemCapabilitiesService. *@
                @if (Capabilities.HasSolar)
                {
                    <RadzenPanelMenuItem Text="Solar power"
                                         Click="@CollapseMenu"
                                         Path="solarpower"
                                         Icon="wb_sunny" />
                }
                <RadzenPanelMenuItem Text="Consumption"
                                     Click="@CollapseMenu"
                                     Path="consumption"
                                     Icon="energy" />
                <RadzenPanelMenuItem Text="Batteries"
                                     Click="@CollapseMenu"
                                     Path="batteries"
                                     Icon="battery_6_bar" />
                <RadzenPanelMenuItem Text="Status history"
                                     Path="sessystatushistory"
                                     Click="@CollapseMenu"
                                     Icon="timeline" />
                <RadzenPanelMenuItem Text="Sessy energy history"
                                     Path="energyhistory"
                                     Click="@CollapseMenu"
                                     Icon="history" />
                <RadzenPanelMenuItem Text="Epex prices"
                                     Path="epexprices"
                                     Click="@CollapseMenu"
                                     Icon="price_change" />
                <RadzenPanelMenuItem Text="Sessy financial results"
                                     Path="financialResults"
                                     Click="@CollapseMenu"
                                     Icon="savings" />
                <RadzenPanelMenuItem Text="Statistics"
                                     Path="energystatistics"
                                     Click="@CollapseMenu"
                                     Icon="monitoring" />
                @* Notification dot when Tips & Checks has something to say. data-sessy-badge lands
                   on the <li> and the dot is drawn on the icon, so it is visible with the menu
                   collapsed to icons as well. Radzen writes class= after @attributes, so a class of
                   our own would be overwritten — see site.css. *@
                <RadzenPanelMenuItem Text="Settings"
                                     Path="settings"
                                     Click="@CollapseMenu"
                                     data-sessy-badge="@SettingsBadge"
                                     title="@SettingsMenuTitle"
                                     Icon="settings" />
                <RadzenPanelMenuItem Text="Data Editor"
                                     Path="dataeditor"
                                     Click="@CollapseMenu"
                                     Icon="table_edit" />
            </RadzenPanelMenu>
            <RadzenBody Style="height: 100%; overflow-y: auto;">
                @* <RadzenText>Width: @screenWidth height: @screenHeight</RadzenText> *@
                <div class="rz-p-4">
                    @Body
                </div>
            </RadzenBody>
            <RadzenFooter>

            </RadzenFooter>
        </RadzenLayout>
    </CascadingValue>
</CascadingValue>

