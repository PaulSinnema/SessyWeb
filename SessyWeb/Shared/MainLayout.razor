@inherits LayoutComponentBase
@implements IDisposable
@inject CookieThemeService CookieThemeService
@inject ThemeService ThemeService
@inject RadzenTheme RadzenTheme
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment HostEnvironment
@inject SystemCapabilitiesService Capabilities
@inject SettingsService SettingsService

@{
    // Bump the version in SessyCommon/AppInfo.cs — Program.cs writes that same value into the
    // AppVersions table, so the database records which build it belongs to.
    string Version = SessyCommon.AppInfo.Version;
}

<AntiforgeryToken />

<CascadingValue Value=@ScreenInfo Name="ScreenInfo" IsFixed=false>
    <CascadingValue Value="(Action<bool>)SetIsBusy">
        @{
            var show = ((ScreenInfo.IsMobile && ScreenInfo.IsLandscape) || !ScreenInfo.IsMobile);
        }

        <RadzenTooltip />
        <RadzenChartTooltip />
        <RadzenTheme Theme="@NewTheme" />

        <BusyOverlay @ref="_busyOverlay" />

        @{
            var isMobile = ScreenInfo.IsMobile;
        }

        <RadzenLayout Style="height: 100vh;">
            <RadzenHeader>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0"
                             class="header-stack">

                    <RadzenSidebarToggle Click="@ToggleDisplayStyle" />

                    <a href="https://sessy.nl" target="_blank" Style="background-color: var(--sessy-logo-bg); max-width: 120px; flex-shrink: 0;">
                        <RadzenImage Path="/Images/sessy.svg" Style="padding: 5px;" />
                    </a>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="header-theme" Style="margin-left: 16px;">
                        @if (!isMobile)
                        {
                            <RadzenLabel Text="@T("Theme:")" Style="margin-right: 10px;" />
                        }
                        <RadzenDropDown Style="@(isMobile ? "width: 110px;" : "width: 200px;")"
                                        Name="ThemeDropDown"
                                        TValue="string"
                                        Value="@ThemeService.Theme"
                                        ValueChanged="@ChangeTheme"
                                        Data="@Themes.Free"
                                        TextProperty=@nameof(Theme.Text)
                                        ValueProperty=@nameof(Theme.Value) />
                        @if (HostEnvironment.IsDevelopment())
                        {
                            <RadzenBadge Text="@T("TEST")" BadgeStyle="BadgeStyle.Warning" Style="margin-left: 10px; font-weight: bold;" />
                        }
                        <span class="language-flags">
                            @foreach (var language in SessyWeb.Texts.Languages)
                            {
                                <button type="button"
                                        class="@(language.Code == CurrentLanguage ? "language-flag active" : "language-flag")"
                                        title="@language.Name"
                                        @onclick="() => ChangeLanguageAsync(language.Code)">
                                    <img src="@language.Flag" alt="@language.Name" />
                                </button>
                            }
                        </span>
                        @if (!isMobile)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin-left: 10px; color:var(--rz-text-secondary-color)">@Version</RadzenText>
                        }
                    </RadzenStack>

                    @if (show)
                    {
                        <Clock />
                    }
                </RadzenStack>
            </RadzenHeader>

            <RadzenPanelMenu DisplayStyle="@DisplayStyle" Style="@MenuStyle">
                <RadzenPanelMenuItem Text="@T("Charging hours")"
                                     Path="charginghours"
                                     Click="@CollapseMenu"
                                     Icon="bolt" />
                @if (DeveloperOptions)
                {
                    <RadzenPanelMenuItem Text="@T("Planner analysis")"
                                         Path="planneranalysis"
                                         Click="@CollapseMenu"
                                         Icon="analytics" />
                }
                @* No inverter configured means no measurements to show — see SystemCapabilitiesService. *@
                @if (Capabilities.HasSolar)
                {
                    <RadzenPanelMenuItem Text="@T("Solar power")"
                                         Click="@CollapseMenu"
                                         Path="solarpower"
                                         Icon="wb_sunny" />
                }
                <RadzenPanelMenuItem Text="@T("Consumption")"
                                     Click="@CollapseMenu"
                                     Path="consumption"
                                     Icon="energy" />
                <RadzenPanelMenuItem Text="@T("Batteries")"
                                     Click="@CollapseMenu"
                                     Path="batteries"
                                     Icon="battery_6_bar" />
                <RadzenPanelMenuItem Text="@T("Status history")"
                                     Path="sessystatushistory"
                                     Click="@CollapseMenu"
                                     Icon="timeline" />
                <RadzenPanelMenuItem Text="@T("Sessy energy history")"
                                     Path="energyhistory"
                                     Click="@CollapseMenu"
                                     Icon="history" />
                <RadzenPanelMenuItem Text="@T("EPEX prices")"
                                     Path="epexprices"
                                     Click="@CollapseMenu"
                                     Icon="price_change" />
                <RadzenPanelMenuItem Text="@T("Sessy financial results")"
                                     Path="financialResults"
                                     Click="@CollapseMenu"
                                     Icon="savings" />
                <RadzenPanelMenuItem Text="@T("Statistics")"
                                     Path="energystatistics"
                                     Click="@CollapseMenu"
                                     Icon="monitoring" />
                @* Notification dot when Tips & Checks has something to say. data-sessy-badge lands
                   on the <li> and the dot is drawn on the icon, so it is visible with the menu
                   collapsed to icons as well. Radzen writes class= after @attributes, so a class of
                   our own would be overwritten — see site.css. *@
                <RadzenPanelMenuItem Text="@T("Settings")"
                                     Path="settings"
                                     Click="@CollapseMenu"
                                     data-sessy-badge="@SettingsBadge"
                                     title="@SettingsMenuTitle"
                                     Icon="settings" />
                <RadzenPanelMenuItem Text="@T("Data Editor")"
                                     Path="dataeditor"
                                     Click="@CollapseMenu"
                                     Icon="table_edit" />
            </RadzenPanelMenu>
            <RadzenBody Style="height: 100%; overflow-y: auto;">
                @* <RadzenText>Width: @screenWidth height: @screenHeight</RadzenText> *@
                <div class="rz-p-4">
                    @* Radzen formats dates and numbers the European way (dd-MM-yyyy, decimal comma), whatever the server's culture. *@
                    <CascadingValue Name="DefaultCulture" Value="@EuropeanCulture">
                        <CascadingValue Name="Language" Value="@LanguageState.Code">
                            @Body
                        </CascadingValue>
                    </CascadingValue>
                </div>
            </RadzenBody>
            <RadzenFooter>

            </RadzenFooter>
        </RadzenLayout>
    </CascadingValue>
</CascadingValue>

